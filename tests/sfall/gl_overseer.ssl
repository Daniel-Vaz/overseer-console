/*
 * A global script that calls what the engine of Fallout 2 was given of sfall
 * (engines/fallout2/patches 0008-0016) and writes what it saw into a virtual
 * file kept in the save, sfallfs.sav, for game.spec.ts to read:
 *   byte 0: a short written is read back, high byte first
 *   byte 1: a virtual file copied from another, read as the engine reads files
 *   byte 2: the player's traits, emptied with remove_trait and set with add_trait
 *   bytes 3, 4: the world map's view, moved with set_viewport_x/y
 *   byte 5: the knockback and heave-ho calls ran
 *   byte 6: an MP3 of the mod's (overseer.mp3, a second of silence) plays
 *   byte 7: the player's Hero Appearance style, after set_hero_style(1)
 *   bytes 8 to 13: the original program's memory (0015), each 1 when right:
 *     8: the game's time, read where the original keeps it
 *     9: the player's name, written there and read with obj_name
 *     10: the player's Strength, read from their proto
 *     11: the mark before an object's block in the original, for the player
 *     12: a byte of the original's code a mod changes, changed and put back
 *     13: one of its functions called (the player's unspent skill points)
 *   bytes 14 to 16: the version of sfall it is told, that of the ddraw.dll the
 *     mod came with (0016)
 *   bytes 17, 18: two settings of a folder of the mods folder, packed: the
 *     first as the player changed it, the second as it came (0019)
 *   byte 19: the sfall settings the engine always acts on read as on (0021)
 *   byte 20: intface_hide/show/is_hidden, get_current_inven_size and
 *     exec_map_update_scripts (0024)
 *   byte 21: set_can_rest_on_map and get_can_rest_on_map (0025)
 *   byte 22: set_drugs_data, for a drug in the mod's DrugsFile and one not (0026)
 *   byte 23: interface_overlay and interface_print got through: the words are
 *     left on the interface bar for the test to see (0027)
 *   byte 24: 66, the script got to its end, setting off an explosion for
 *     hs_onexplosion on the way
 * In a game loaded from a save, which brings that file back, it writes only
 * "overseer/loaded": the style the save brought back.
 * Compiled with sfall's sslc: see docs/developing.md.
 */
procedure start;

procedure start begin
   variable id, source, copy, trait, traits, sound, points;
   if (not(game_loaded)) then return;

   if (fs_find("overseer/result") != -1) then begin
      id := fs_create("overseer/loaded", 1);
      fs_resize(id, -1);
      fs_write_byte(id, get_sfall_global_int("HApStyle"));
      return;
   end

   id := fs_create("overseer/result", 25);
   fs_resize(id, -1);

   fs_write_short(id, 0x1234);
   fs_seek(id, 0);
   if (fs_read_short(id) == 0x1234) then traits := 1; else traits := 0;
   fs_seek(id, 0);
   fs_write_byte(id, traits);

   source := fs_create("overseer/source", 3);
   fs_write_bstring(source, "abc");
   copy := fs_copy("overseer/copy", "overseer/source");
   if (fs_size(copy) == 3 and fs_read_byte(copy) == 97) then fs_write_byte(id, 1); else fs_write_byte(id, 0);

   trait := 0;
   while (trait < 16) do begin
      remove_trait(trait);
      trait += 1;
   end
   sfall_func1("add_trait", 8);
   sfall_func1("add_trait", 10);
   traits := 0;
   trait := 0;
   while (trait < 16) do begin
      if (has_trait(2, dude_obj, trait)) then traits += 1;
      trait += 1;
   end
   if (traits == 2 and has_trait(2, dude_obj, 8) and has_trait(2, dude_obj, 10)) then fs_write_byte(id, 1); else fs_write_byte(id, 0);

   set_viewport_x(5);
   set_viewport_y(7);
   fs_write_byte(id, get_viewport_x);
   fs_write_byte(id, get_viewport_y);

   set_target_knockback(dude_obj, 0, 5);
   remove_target_knockback(dude_obj);
   set_attacker_knockback(dude_obj, 1, 2.0);
   remove_attacker_knockback(dude_obj);
   apply_heaveho_fix;
   fs_write_byte(id, 1);

   // Looping (1), so that a sound which plays has an id.
   sound := play_sfall_sound("sound\\sfx\\overseer.mp3", 1);
   if (sound != 0) then fs_write_byte(id, 1); else fs_write_byte(id, 0);
   stop_sfall_sound(sound);

   set_hero_style(1);
   fs_write_byte(id, get_sfall_global_int("HApStyle"));

   if (read_int(0x51C720) == game_time) then fs_write_byte(id, 1); else fs_write_byte(id, 0);

   write_string(0x56D75C, "Overseer");
   if (obj_name(dude_obj) == "Overseer" and read_string(0x56D75C) == "Overseer") then fs_write_byte(id, 1); else fs_write_byte(id, 0);

   // The proto's base stats are 36 bytes in.
   if (read_int(0x51C370 + 36) == get_pc_base_stat(0)) then fs_write_byte(id, 1); else fs_write_byte(id, 0);

   if (read_int(dude_obj - 4) == 0xFEEDFACE) then fs_write_byte(id, 1); else fs_write_byte(id, 0);

   // The largest of the Jinxed roll, as gl_zTraits_Plus of Fallout Yesterday changes it.
   traits := read_byte(0x4238BC);
   write_byte(0x4238BC, 0);
   if (traits == 1 and read_byte(0x4238BC) == 0) then begin
      write_int(0x4238BC, traits);
      if (read_int(0x4238BC) == 1) then fs_write_byte(id, 1); else fs_write_byte(id, 0);
   end else fs_write_byte(id, 0);

   // stat_pc_set(PCSTAT_unspent_skill_points, ...)
   points := get_pc_stat(0);
   call_offset_v2(0x4AF910, 0, points + 3);
   if (get_pc_stat(0) == points + 3) then fs_write_byte(id, 1); else fs_write_byte(id, 0);
   call_offset_v2(0x4AF910, 0, points);

   fs_write_byte(id, sfall_ver_major);
   fs_write_byte(id, sfall_ver_minor);
   fs_write_byte(id, sfall_ver_build);

   // A settings file in a folder of the mods folder, which the console packs into an archive (0019): one setting
   // as the player changed it on the mod's page, in the copy the console writes, the other as it came. Then the
   // settings the engine always acts on, read as on (0019, 0021).
   fs_write_byte(id, get_ini_setting("mods\\OvTest.dat\\ovtest.ini|Test|Value"));
   fs_write_byte(id, get_ini_setting("mods\\OvTest.dat\\ovtest.ini|Test|Other"));
   if (get_ini_setting("ddraw.ini|Debugging|AllowUnsafeScripting") == 1 and get_ini_setting("ddraw.ini|Misc|UseFileSystemOverride") == 1) then fs_write_byte(id, 1); else fs_write_byte(id, 0);

   // The interface bar hidden and shown again, the size of what the player carries (the ready-made character has
   // something), and the map's scripts run (0024).
   sfall_func0("intface_hide");
   traits := sfall_func0("intface_is_hidden");
   sfall_func0("intface_show");
   sfall_func0("exec_map_update_scripts");
   if (traits == 1 and sfall_func0("intface_is_hidden") == 0 and sfall_func1("get_current_inven_size", dude_obj) > 0) then fs_write_byte(id, 1); else fs_write_byte(id, 0);

   // No resting on this map, at any elevation, and nothing said of the next map (0025).
   sfall_func3("set_can_rest_on_map", cur_map_index, -1, 0);
   if (sfall_func2("get_can_rest_on_map", cur_map_index, 0) == 0 and sfall_func2("get_can_rest_on_map", cur_map_index, 2) == 0 and sfall_func2("get_can_rest_on_map", cur_map_index + 1, 0) == -1) then fs_write_byte(id, 1); else fs_write_byte(id, 0);

   // A drug of the mod's DrugsFile (Stimpak, 40) changed, and one not in it refused (0026).
   if (sfall_func3("set_drugs_data", 0, 40, 2) == 0 and sfall_func3("set_drugs_data", 1, 40, 60) == 0 and sfall_func3("set_drugs_data", 0, 41, 2) == -1) then fs_write_byte(id, 1); else fs_write_byte(id, 0);

   // Words on an overlay over the interface bar, which stay there as it is drawn again beneath (0027).
   // Shadowed (0x10000), in colour 215.
   points := 0x10000 + 215;
   sfall_func2("interface_overlay", 4, 1);
   sfall_func5("interface_print", "OVERSEER", 4, 20, 30, points);
   fs_write_byte(id, 1);

   // An explosion of no damage three tiles away, for hs_onexplosion (0022).
   explosion(tile_num_in_direction(tile_num(dude_obj), 2, 3), elevation(dude_obj), 0);

   fs_write_byte(id, 66);
end
