/*
 * A hook script, found by its file name: counts the times it is run (once when
 * the game starts, then at each change of game mode) in a virtual file kept in
 * the save. See gl_overseer.ssl.
 *
 * It also sets global variable 0 to 7 and keeps what it reads back in
 * "overseer/globalvar": 8 once hs_setglobalvar runs (in a game loaded).
 */
procedure start;

procedure start begin
   variable id, count;
   id := fs_find("overseer/hooks");
   if (id == -1) then begin
      id := fs_create("overseer/hooks", 4);
      fs_resize(id, -1);
   end
   fs_seek(id, 0);
   count := fs_read_int(id);
   fs_seek(id, 0);
   fs_write_int(id, count + 1);

   set_global_var(0, 7);
   id := fs_find("overseer/globalvar");
   if (id == -1) then begin
      id := fs_create("overseer/globalvar", 1);
      fs_resize(id, -1);
   end
   fs_seek(id, 0);
   fs_write_byte(id, global_var(0));
end
