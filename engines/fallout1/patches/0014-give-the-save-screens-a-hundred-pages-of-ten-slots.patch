+
+// CE: turns `delta` pages, the cursor on the same row of the new one. False
+// when there is no page that way.
+static bool ChangeSlotPage(int delta)
+{
+    int page = std::clamp(slot_page + delta, 0, LOAD_SAVE_PAGE_COUNT - 1);
+    if (page == slot_page) {
+        return false;
+    }
+
+    gsound_play_sfx_file("ib1p1xx1");
+    MoveSlotCursor(page * LOAD_SAVE_SLOTS_PER_PAGE + slot_cursor % LOAD_SAVE_SLOTS_PER_PAGE);
+    return true;
+}
+
+// CE: where the row that turns the pages is, under the ten slots.
+static int SlotPageRowY()
+{
+    return 87 + LOAD_SAVE_SLOTS_PER_PAGE * (3 * text_height() + 4);
+}
+
+// CE: the pages a click on that row turns: "<<" ten back, BACK one, MORE one
+// on, ">>" ten on. 0 elsewhere.
+static int SlotPageDeltaAt(int mouseX, int mouseY)
+{
+    int y = SlotPageRowY();
+    if (mouseY < y || mouseY >= y + text_height()) {
+        return 0;
+    }
+
+    if (mouseX >= 55 && mouseX <= 85) {
+        return -kSlotPageFastStep;
+    }
+    if (mouseX >= 86 && mouseX <= 180) {
+        return -1;
+    }
+    if (mouseX >= 195 && mouseX <= 250) {
+        return 1;
+    }
+    if (mouseX >= 251 && mouseX <= 285) {
+        return kSlotPageFastStep;
+    }
+    return 0;
 }
 
