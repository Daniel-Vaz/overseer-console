+// Returns the zero-based slot named by `--dev-load-game=N`, or -1.
+static int main_parse_load_game_slot(int argc, char** argv)
+{
+    const char* prefix = "--dev-load-game=";
+    size_t prefixLength = strlen(prefix);
+
+    for (int index = 1; index < argc; index++) {
+        if (strncmp(argv[index], prefix, prefixLength) == 0) {
+            const char* value = argv[index] + prefixLength;
+            char* end = NULL;
+            long slot = strtol(value, &end, 10);
+            if (end != value && *end == '\0' && slot >= 1 && slot <= 10) {
+                return (int)slot - 1;
+            }
+
+            debug_printf("MAIN: invalid --dev-load-game value '%s'\n", value);
+        }
+    }
+
+    return -1;
+}
