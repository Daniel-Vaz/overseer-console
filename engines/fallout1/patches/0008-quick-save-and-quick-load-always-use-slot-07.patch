+// CE: Whether slot 07 holds a quick save to load: 1 it does, 0 it is empty,
+// -1 what is there cannot be read. Looked at before anything of the game in
+// progress is let go of.
+static int QuickSlotState()
+{
+    snprintf(gmpath, sizeof(gmpath), "%s\\%s%.2d\\%s", "SAVEGAME", "SLOT", kQuickSaveSlot + 1, "SAVE.DAT");
+    flptr = db_fopen(gmpath, "rb");
+    if (flptr == NULL) {
+        return 0;
+    }
+
+    int state = LoadHeader(kQuickSaveSlot) == -1 ? -1 : 1;
+    db_fclose(flptr);
+    return state;
+}
