+// SFALL: DrugExploitFix: how many of the places that ask for lasting stats
+// (see stat_lasting_begin) are under way.
+static int stat_lasting = 0;
+
+// SFALL: DrugExploitFix: while a skill book is read, a level's perk is picked
+// or skill points are spent, primary stats leave out what drugs, withdrawal,
+// radiation and the perks of worn armour and held weapons add only for now.
+void stat_lasting_begin()
+{
+    stat_lasting++;
+}
+
+void stat_lasting_end()
+{
+    stat_lasting--;
+}
+
+typedef struct LastingBonus {
+    int stat;
+    int bonus;
+} LastingBonus;
+
+static void stat_lasting_leave_out_event(int eventType, void* data, void* context)
+{
+    LastingBonus* lasting = (LastingBonus*)context;
+    switch (eventType) {
+    case EVENT_TYPE_DRUG: {
+        // What is still to come of a drug undoes what it does now. A stat
+        // chosen at random (-2) is passed over, as sfall does.
+        DrugEffectEvent* drug = (DrugEffectEvent*)data;
+        for (int index = drug->stats[0] == -2 ? 2 : 0; index < 3; index++) {
+            if (drug->stats[index] == lasting->stat) {
+                lasting->bonus += drug->modifiers[index];
+            }
+        }
+        break;
+    }
+    case EVENT_TYPE_WITHDRAWAL: {
+        WithdrawalEvent* withdrawal = (WithdrawalEvent*)data;
+        if (withdrawal->field_0 != 1) {
+            lasting->bonus -= perk_stat_modifier(withdrawal->perk, lasting->stat);
+        }
+        break;
+    }
+    case EVENT_TYPE_RADIATION: {
+        RadiationEvent* radiation = (RadiationEvent*)data;
+        if (lasting->stat != STAT_LUCK && radiation->radiationLevel >= 1 && radiation->radiationLevel <= RADIATION_LEVEL_COUNT) {
+            lasting->bonus -= rad_bonus[radiation->radiationLevel - 1][lasting->stat];
+        }
+        break;
+    }
+    }
+}
+
+static int stat_get_lasting_bonus(Object* critter, int stat)
+{
+    LastingBonus lasting = { stat, stat_get_bonus(critter, stat) };
+
+    Object* armor = inven_worn(critter);
+    if (armor != NULL) {
+        lasting.bonus -= perk_stat_modifier(item_ar_perk(armor), stat);
+    }
+
+    Object* hands[2] = { inven_right_hand(critter), inven_left_hand(critter) };
+    for (Object* item : hands) {
+        if (item != NULL && item_get_type(item) == ITEM_TYPE_WEAPON) {
+            lasting.bonus -= perk_stat_modifier(item_w_perk(item), stat);
+        }
+    }
+
+    queue_for_each(critter, stat_lasting_leave_out_event, &lasting);
+    return lasting.bonus;
+}
