--- /dev/null
+++ b/src/game/sfall_config.cc
@@ -0,0 +1,55 @@
+#include "game/sfall_config.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "game/config.h"
+#include "platform_compat.h"
+
+namespace fallout {
+
+SfallSettings sfall_settings;
+
+// A number as sfall reads one: decimal, or hexadecimal after 0x.
+static int sfall_config_int(Config* config, const char* section, const char* key, int defaultValue)
+{
+    char* string;
+    if (!config_get_string(config, section, key, &string)) {
+        return defaultValue;
+    }
+    return static_cast<int>(strtol(string, NULL, 0));
+}
+
+void sfall_config_init()
+{
+    sfall_settings = SfallSettings();
+
+    // (config_load says it read a file that is not there.)
+    FILE* stream = compat_fopen("ddraw.ini", "rt");
+    if (stream == NULL) {
+        return;
+    }
+    fclose(stream);
+
+    Config config;
+    if (!config_init(&config)) {
+        return;
+    }
+
+    if (config_load(&config, "ddraw.ini", false)) {
+        // As sfall1 has them when they are left out.
+        sfall_settings.dialogueFix = sfall_config_int(&config, "Misc", "DialogueFix", 1) != 0;
+        sfall_settings.removeCriticalTimeLimits = sfall_config_int(&config, "Misc", "RemoveCriticalTimelimits", 0) != 0;
+        sfall_settings.bonusHthDamageFix = sfall_config_int(&config, "Misc", "BonusHtHDamageFix", 1) != 0;
+        sfall_settings.playIdleAnimOnReload = sfall_config_int(&config, "Misc", "PlayIdleAnimOnReload", 0) != 0;
+        sfall_settings.dodgyDoorsFix = sfall_config_int(&config, "Misc", "DodgyDoorsFix", 0) != 0;
+        sfall_settings.stackEmptyWeapons = sfall_config_int(&config, "Misc", "StackEmptyWeapons", 0) != 0;
+        sfall_settings.freeWeight = sfall_config_int(&config, "Misc", "FreeWeight", 0) != 0;
+        sfall_settings.drugExploitFix = sfall_config_int(&config, "Misc", "DrugExploitFix", 0) != 0;
+        sfall_settings.removeFriendlyFoe = sfall_config_int(&config, "Misc", "RemoveFriendlyFoe", 0) != 0;
+    }
+
+    config_exit(&config);
+}
+
+} // namespace fallout
