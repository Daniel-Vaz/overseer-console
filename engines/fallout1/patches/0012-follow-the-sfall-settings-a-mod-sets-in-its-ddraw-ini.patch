+// What `perk_add_effect` adds to a stat.
+int perk_stat_modifier(int perk, int stat)
+{
+    if (perk < 0 || perk >= PERK_COUNT) {
+        return 0;
+    }
+
+    PerkDescription* perkDescription = &(perk_data[perk]);
+
+    int modifier = 0;
+    if (perkDescription->stat == stat) {
+        modifier += perkDescription->stat_modifier;
+    }
+
+    if (perkDescription->max_rank == -1 && stat >= 0 && stat < PRIMARY_STAT_COUNT) {
+        modifier += perkDescription->required_stat_levels[stat];
+    }
+
+    return modifier;
+}
+
