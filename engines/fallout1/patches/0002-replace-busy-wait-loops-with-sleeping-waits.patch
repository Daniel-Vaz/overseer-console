+// CE: Sleeps for (most of) the given number of microseconds instead of
+// spinning, so hosts with a cooperative event loop (browsers) keep running.
+static void _syncDelay(int microseconds)
+{
+    int ms = microseconds / 1000 - 3;
+    SDL_Delay(ms > 0 ? ms : 1);
+}
