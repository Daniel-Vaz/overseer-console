@@ -673,6 +673,18 @@ unsigned int elapsed_time(unsigned int start)
     return elapsed_tocks(end, start);
 }
 
+// CE: Sleeps until `ms` milliseconds have passed since `start` (as returned by
+// `get_time`). Replaces the original `while (elapsed_time(start) < ms) {}`
+// busy-wait loops, which starve hosts with a cooperative event loop.
+void wait_until_elapsed(unsigned int start, unsigned int ms)
+{
+    unsigned int elapsed = elapsed_time(start);
+    while (elapsed < ms) {
+        SDL_Delay(ms - elapsed);
+        elapsed = elapsed_time(start);
+    }
+}
+
