+// Whether what lies on the ground is lit up.
+static bool highlighting = false;
+
+// Whether the middle mouse button was down at the last look.
+static bool middleMouseDown = false;
+
+static bool sfall_input_key_held(int key)
+{
+    if (key <= 0 || key >= DIK_MAP_COUNT) {
+        return false;
+    }
+
+#if defined(__EMSCRIPTEN__)
+    if (overseer_script_key(key)) {
+        return true;
+    }
+#endif
+
+    SDL_Scancode scancode = kDiks[key];
+    if (scancode == SDL_SCANCODE_UNKNOWN) {
+        return false;
+    }
+
+    const Uint8* state = SDL_GetKeyboardState(NULL);
+    return state[scancode] != 0;
+}
+
+// Presses and lets go of a key, as the keyboard does.
+static void sfall_input_press_key(int key)
+{
+    if (key <= 0 || key >= DIK_MAP_COUNT || kDiks[key] == SDL_SCANCODE_UNKNOWN) {
+        return;
+    }
+
+    SDL_Event event;
+    SDL_zero(event);
+    event.type = SDL_KEYDOWN;
+    event.key.timestamp = SDL_GetTicks();
+    event.key.windowID = gSdlWindow != NULL ? SDL_GetWindowID(gSdlWindow) : 0;
+    event.key.state = SDL_PRESSED;
+    event.key.keysym.scancode = kDiks[key];
+    event.key.keysym.sym = SDL_GetKeyFromScancode(kDiks[key]);
+    event.key.keysym.mod = SDL_GetModState();
+    SDL_PushEvent(&event);
+
+    event.type = SDL_KEYUP;
+    event.key.state = SDL_RELEASED;
+    SDL_PushEvent(&event);
+}
+
+// What lies on the ground on the elevation in view, items in yellow, and
+// containers and the bodies that can be searched in grey if the mod asks for
+// them; or none of it.
+static void sfall_input_outline_items(bool on)
+{
+    for (Object* object = obj_find_first_at(map_elevation); object != NULL; object = obj_find_next_at()) {
+        if (object->owner != NULL) {
+            continue;
+        }
+
+        bool container;
+        switch (FID_TYPE(object->fid)) {
+        case OBJ_TYPE_ITEM:
+            container = (object->flags & OBJECT_NO_HIGHLIGHT) != 0;
+            break;
+        case OBJ_TYPE_CRITTER: {
+            if (!critter_is_dead(object)) {
+                continue;
+            }
+
+            Proto* proto;
+            if (proto_ptr(object->pid, &proto) == -1 || (proto->critter.data.flags & CRITTER_NO_STEAL) != 0) {
+                continue;
+            }
+
+            container = true;
+            break;
+        }
+        default:
+            continue;
+        }
+
+        if (!on) {
+            object->outline = 0;
+        } else if ((object->flags & OBJECT_HIDDEN) == 0) {
+            if (!container) {
+                object->outline = OUTLINE_TYPE_ITEM;
+            } else if (sfall_settings.highlightContainers) {
+                object->outline = OUTLINE_TYPE_4;
+            }
+        }
+    }
+
+    tile_refresh_display();
+}
+
+void sfall_input_process()
+{
+    if (sfall_settings.middleMouseKey != 0) {
+        bool down = (SDL_GetMouseState(NULL, NULL) & SDL_BUTTON(SDL_BUTTON_MIDDLE)) != 0;
+        if (down && !middleMouseDown) {
+            sfall_input_press_key(sfall_settings.middleMouseKey);
+        }
+        middleMouseDown = down;
+    }
+
+    if (sfall_settings.itemHighlightsKey != 0) {
+        bool held = sfall_input_key_held(sfall_settings.itemHighlightsKey);
+        if (held != highlighting) {
+            highlighting = held;
+            sfall_input_outline_items(held);
+        }
+    }
+}
+
+bool sfall_input_highlighting()
+{
+    return highlighting;
+}
+
+void sfall_input_outline_removed()
+{
+    if (highlighting) {
+        sfall_input_outline_items(true);
+    }
+}
+
+} // namespace fallout
