 // 0x4B3BB8
+// SFALL: [Speed]: the game's clock runs this much faster, in percent, while
+// the game is played on the map, in combat or on the world map - not in its
+// screens and menus. Their loops switch it on while they wait for input, and
+// a look at the clock goes by the switch for all the time since the last one:
+// each turn's wait for the next frame included.
+static int time_scale_percent = 100;
+static bool time_scale_active = false;
+
+void set_time_scale(int percent)
+{
+    time_scale_percent = percent > 0 ? percent : 100;
+}
+
+void set_time_scale_active(bool active)
+{
+    time_scale_active = active;
+}
+
+// The game's clock: SDL's, gone faster while the scale is on, and never
+// jumping when it goes on or off.
+static unsigned int scaled_ticks()
+{
+    static bool started = false;
+    static unsigned int lastTicks;
+    static unsigned int ticks;
+    static unsigned int fraction;
+
+    unsigned int now = SDL_GetTicks();
+    if (!started) {
+        started = true;
+        lastTicks = now;
+        ticks = now;
+    }
+
+    unsigned int elapsed = now - lastTicks;
+    lastTicks = now;
+
+    if (time_scale_active && time_scale_percent != 100) {
+        unsigned long long scaled = (unsigned long long)elapsed * time_scale_percent + fraction;
+        elapsed = (unsigned int)(scaled / 100);
+        fraction = (unsigned int)(scaled % 100);
+    }
+
+    ticks += elapsed;
+    return ticks;
+}
+
 unsigned int get_time()
 {
-    return SDL_GetTicks();
+    return scaled_ticks();
 }
 
