                     mouse_simulate_input(gesture.x - prevx, gesture.y - prevy, MOUSE_STATE_LEFT_BUTTON_DOWN);
@@ -497,9 +519,16 @@ void mouse_info()
         y = 0;
     }
 
-    // Adjust for mouse senstivity.
