 // 0x4B4DD8
+// CE: Converts an absolute pointer position into a delta from the current
+// cursor hot spot, so that the rest of the (delta based) pipeline is unchanged.
+static void mouse_absolute_to_delta(int* x, int* y)
+{
+    int currentX;
+    int currentY;
+    mouse_get_position(&currentX, &currentY);
+
+    *x -= currentX;
+    *y -= currentY;
+}
