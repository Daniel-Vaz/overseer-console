+            }
+
             if (gesture.numberOfTouches == 1) {
                 mouse_simulate_input(0, 0, MOUSE_STATE_LEFT_BUTTON_DOWN);
             } else if (gesture.numberOfTouches == 2) {
@@ -448,6 +465,11 @@ void mouse_info()
                 prevy = gesture.y;
             }
 
+            if (!dxinput_mouse_is_relative() && gesture.numberOfTouches == 1) {
