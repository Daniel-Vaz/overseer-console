Add Emscripten build target and storage sync

Adds a CMake branch for Emscripten (SDL2 from the ports collection, Asyncify for
the blocking main loop) and compat_fs_sync(), which asks the host to persist
in-memory file changes. It is called after a saved game is written and after the
settings file is saved, and does nothing outside the browser.
---
diff --git a/CMakeLists.txt b/CMakeLists.txt
index f341df7..30ff960 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -345,7 +345,27 @@ if(APPLE)
     set(MACOSX_BUNDLE_BUNDLE_VERSION "1.0.0")
 endif()
 
-if((NOT ${CMAKE_SYSTEM_NAME} MATCHES "Linux") AND (NOT ${CMAKE_SYSTEM_NAME} MATCHES "FreeBSD") AND (NOT ${CMAKE_SYSTEM_NAME} MATCHES "OpenBSD"))
+if(${CMAKE_SYSTEM_NAME} MATCHES "Emscripten")
+    # Browser (WebAssembly) build. SDL2 comes from the Emscripten ports
+    # collection, the engine's blocking loops are handled by Asyncify.
+    # USE_SDL=2 (rather than --use-port=sdl2) also keeps Emscripten's legacy
+    # JavaScript SDL 1.2 emulation out of the link, which would otherwise
+    # silently stand in for any SDL symbol missing from the binary.
+    target_compile_options(${EXECUTABLE_NAME} PUBLIC "-sUSE_SDL=2")
+    target_link_options(${EXECUTABLE_NAME} PRIVATE
+        "-sUSE_SDL=2"
+        "-sASYNCIFY"
+        "-sASYNCIFY_STACK_SIZE=65536"
+        "-sENVIRONMENT=web"
+        "-sALLOW_MEMORY_GROWTH"
+        "-sCASE_INSENSITIVE_FS"
+        "-lidbfs.js"
+        "-sMODULARIZE"
+        "-sEXPORT_NAME=falloutce"
+        "-sEXPORTED_RUNTIME_METHODS=callMain,FS"
+        "-sEXIT_RUNTIME"
+    )
+elseif((NOT ${CMAKE_SYSTEM_NAME} MATCHES "Linux") AND (NOT ${CMAKE_SYSTEM_NAME} MATCHES "FreeBSD") AND (NOT ${CMAKE_SYSTEM_NAME} MATCHES "OpenBSD"))
     add_subdirectory("third_party/sdl2")
 else()
     find_package(SDL2)
