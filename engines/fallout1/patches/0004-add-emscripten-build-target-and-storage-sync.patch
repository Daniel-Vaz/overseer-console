diff --git a/src/platform_compat.cc b/src/platform_compat.cc
index 972593b..c629ee8 100644
--- a/src/platform_compat.cc
+++ b/src/platform_compat.cc
@@ -25,8 +25,25 @@
 
 #include <SDL.h>
 
+#if defined(__EMSCRIPTEN__)
+#include <emscripten.h>
+#endif
+
 namespace fallout {
 
+#if defined(__EMSCRIPTEN__)
+// clang-format off
+EM_ASYNC_JS(void, compat_fs_sync_impl, (), {
+    await new Promise((resolve) => FS.syncfs(false, (err) => {
+        if (err) {
+            console.warn('FS.syncfs failed', err);
+        }
+        resolve();
+    }));
+});
+// clang-format on
+#endif
+
 int compat_stricmp(const char* string1, const char* string2)
 {
     return SDL_strcasecmp(string1, string2);
@@ -356,4 +373,14 @@ long getFileSize(FILE* stream)
     return filesize;
 }
 
+// CE: Flushes in-memory file changes (saved games, settings) to the host's
+// persistent storage. Only browsers need this, where the file system lives in
+// memory until explicitly synced.
+void compat_fs_sync()
+{
+#if defined(__EMSCRIPTEN__)
+    compat_fs_sync_impl();
+#endif
+}
+
 } // namespace fallout
diff --git a/src/platform_compat.h b/src/platform_compat.h
index 8281726..159c6d8 100644
--- a/src/platform_compat.h
+++ b/src/platform_compat.h
@@ -41,6 +41,7 @@ void compat_windows_path_to_native(char* path);
 void compat_resolve_path(char* path);
 char* compat_strdup(const char* string);
 long getFileSize(FILE* stream);
+void compat_fs_sync();
 
 } // namespace fallout
 
