     return rc;
 }
 
+// CE: Saves into the given slot (zero-based) without asking, the way a quick
+// save does once its slot is known, described as an autosave with the time
+// it was made. Unlike a quick save it leaves the slot the player last picked
+// alone, and shows nothing when it fails: whoever asked for it says so.
+int AutoSaveInSlot(int slot)
+{
+    if (slot < 0 || slot > 9) {
+        return -1;
+    }
+
+    ls_error_code = 0;
+
+    if (!config_get_string(&game_config, GAME_CONFIG_SYSTEM_KEY, GAME_CONFIG_MASTER_PATCHES_KEY, &patches)) {
+        patches = emgpath;
+    }
+
+    int playerSlot = slot_cursor;
+    int cursor = gmouse_get_cursor();
+    slot_cursor = slot;
+
+    snprintf(gmpath, sizeof(gmpath), "%s\\%s%.2d\\%s", "SAVEGAME", "SLOT", slot_cursor + 1, "SAVE.DAT");
+    flptr = db_fopen(gmpath, "rb");
+    if (flptr != NULL) {
+        LoadHeader(slot_cursor);
+        db_fclose(flptr);
+    }
+
+    time_t now = time(NULL);
+    struct tm* local = localtime(&now);
+    snprintf(LSData[slot].description, LOAD_SAVE_DESCRIPTION_LENGTH, "AUTOSAVE %02d:%02d", local->tm_hour, local->tm_min);
+
+    int rc = -1;
+    if (message_init(&lsgame_msgfl)) {
+        char path[COMPAT_MAX_PATH];
+        snprintf(path, sizeof(path), "%s%s", msg_path, "LSGAME.MSG");
+        if (message_load(&lsgame_msgfl, path)) {
+            thumbnail_image[1] = NULL;
+            if (QuickSnapShot() == 1) {
+                rc = SaveSlot();
+            }
+
+            if (thumbnail_image[1] != NULL) {
+                mem_free(snapshot);
+            }
+        }
+        message_exit(&lsgame_msgfl);
+    }
+
+    gmouse_set_cursor(cursor);
+    slot_cursor = playerSlot;
+
+    return rc;
+}
