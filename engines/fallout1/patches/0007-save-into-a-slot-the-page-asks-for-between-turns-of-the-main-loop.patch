+// CE: The page asks for a save now and then (Overseer Console). It is made
+// here, between two turns of the main loop, and only at a moment the player
+// could have made a quick save: outside combat and conversations, while the
+// game takes orders, with the player alive.
+static void main_autosave()
+{
+#if defined(__EMSCRIPTEN__)
+    int state = game_state();
+    if (game_user_wants_to_quit != 0
+        || (state != GAME_STATE_0 && state != GAME_STATE_2)
+        || game_ui_is_disabled()
+        || isInCombat()
+        || (obj_dude->data.critter.combat.results & (DAM_DEAD | DAM_KNOCKED_OUT)) != 0) {
+        return;
+    }
+
+    int slot = overseer_autosave_point();
+    if (slot > 0) {
+        overseer_autosaved(slot, AutoSaveInSlot(slot - 1) == 0 ? 1 : 0);
+    }
+#endif
+}
