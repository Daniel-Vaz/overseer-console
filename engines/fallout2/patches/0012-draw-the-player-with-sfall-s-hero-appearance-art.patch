+// SFALL: Hero Appearance: the race or style picked, as its own words and
+// picture tell of it (game\AppRace.msg and art\skilldex\AppRace.frm, or
+// AppStyle, of the appearance picked).
+static void characterEditorDrawHeroAppearanceCard(bool style)
+{
+    constexpr int CARD_X = 345;
+    constexpr int CARD_Y = 267;
+    blitBufferToBuffer(characterEditorBackground() + (640 * CARD_Y) + CARD_X, 295, 170, 640, gCharacterEditorWindowBuffer + (CARD_Y * 640) + CARD_X, 640);
+
+    MessageList messageList;
+    if (!messageListInit(&messageList)) {
+        return;
+    }
+
+    if (messageListLoad(&messageList, style ? "game\\AppStyle.msg" : "game\\AppRace.msg")) {
+        MessageListItem title;
+        title.num = 100;
+        MessageListItem description;
+        description.num = 101;
+        if (messageListGetItem(&messageList, &title) && messageListGetItem(&messageList, &description)) {
+            characterEditorDrawCardWithOptions(SkillDexFrmId(style ? "AppStyle.frm" : "AppRace.frm"), title.text, nullptr, description.text);
+        }
+    }
+
+    messageListFree(&messageList);
+}
+
+// SFALL: Hero Appearance: picking a race (left and right on its heading, or
+// its arrows) and a style, as sfall does. Returns the key for the rest of the
+// screen, or -1 for one taken.
+static int characterEditorHandleHeroAppearance(int keyCode)
+{
+    bool race = characterEditorSelectedItem == EDITOR_HERO_RACE;
+    bool style = characterEditorSelectedItem == EDITOR_HERO_STYLE;
+
+    // Tab from the style back to the first of the rest.
+    bool leaving = false;
+
+    if (race || style) {
+        switch (keyCode) {
+        case KEY_ARROW_LEFT:
+        case KEY_ARROW_RIGHT:
+            if (!gCharacterEditorIsCreationMode) {
+                return -1;
+            }
+            if (race) {
+                keyCode = keyCode == KEY_ARROW_LEFT ? HERO_RACE_LEFT_BTN_CODE : HERO_RACE_RIGHT_BTN_CODE;
+            } else {
+                keyCode = keyCode == KEY_ARROW_LEFT ? HERO_STYLE_LEFT_BTN_CODE : HERO_STYLE_RIGHT_BTN_CODE;
+            }
+            break;
+        case KEY_ARROW_UP:
+        case KEY_ARROW_DOWN:
+            keyCode = race ? HERO_STYLE_BTN_CODE : HERO_RACE_BTN_CODE;
+            break;
+        case KEY_TAB:
+            if (race) {
+                keyCode = HERO_STYLE_BTN_CODE;
+            } else {
+                characterEditorSelectedItem = EDITOR_FIRST_PRIMARY_STAT;
+                leaving = true;
+            }
+            break;
+        }
+    }
+
+    bool changed = false;
+    if (!leaving) {
+        switch (keyCode) {
+        case HERO_RACE_BTN_CODE:
+        case HERO_STYLE_BTN_CODE:
+            if (characterEditorSelectedItem == (keyCode == HERO_RACE_BTN_CODE ? EDITOR_HERO_RACE : EDITOR_HERO_STYLE)) {
+                return -1;
+            }
+            characterEditorSelectedItem = keyCode == HERO_RACE_BTN_CODE ? EDITOR_HERO_RACE : EDITOR_HERO_STYLE;
+            break;
+        case HERO_RACE_LEFT_BTN_CODE:
+            characterEditorSelectedItem = EDITOR_HERO_RACE;
+            changed = heroAppearanceRace() > 0 && heroAppearanceSetRace(heroAppearanceRace() - 1);
+            break;
+        case HERO_RACE_RIGHT_BTN_CODE:
+            characterEditorSelectedItem = EDITOR_HERO_RACE;
+            changed = heroAppearanceSetRace(heroAppearanceRace() + 1);
+            break;
+        case HERO_STYLE_LEFT_BTN_CODE:
+            characterEditorSelectedItem = EDITOR_HERO_STYLE;
+            changed = heroAppearanceStyle() > 0 && heroAppearanceSetStyle(heroAppearanceStyle() - 1);
+            break;
+        case HERO_STYLE_RIGHT_BTN_CODE:
+            characterEditorSelectedItem = EDITOR_HERO_STYLE;
+            changed = heroAppearanceSetStyle(heroAppearanceStyle() + 1);
+            break;
+        default:
+            return keyCode;
+        }
+
+        if (keyCode >= HERO_RACE_LEFT_BTN_CODE && keyCode <= HERO_STYLE_RIGHT_BTN_CODE) {
+            if (!changed) {
+                soundPlayFile("ib3lu1x1");
+                return -1;
+            }
+            soundPlayFile("ib3p1xx1");
+            heroAppearanceEditorDrawView(gCharacterEditorWindow, gCharacterEditorWindowBuffer, characterEditorBackground(), true);
+        }
+    }
+
+    // What is picked lit up, the rest not; and its card.
+    characterEditorDrawPrimaryStat(PRIMARY_STAT_COUNT, 0, 0);
+    characterEditorDrawOptionalTraits();
+    characterEditorDrawSkills(0);
+    characterEditorDrawPcStats();
+    characterEditorDrawFolders();
+    characterEditorDrawDerivedStats();
+    characterEditorDrawCard();
+    windowRefresh(gCharacterEditorWindow);
+    return -1;
+}
