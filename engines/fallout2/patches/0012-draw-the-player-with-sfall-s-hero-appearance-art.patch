+
+namespace fallout {
+
+// sfall's Hero Appearance (ddraw.ini [Misc] EnableHeroAppearanceMod): the
+// player is drawn with art of their own, of a race and a style picked when
+// the character is made, found in Appearance\h<M|F>R<race>S<style> (a folder,
+// or the same name with .dat) before the game's.
+//
+// The player's critter art has numbers of its own: the critter list is
+// doubled, the second half naming each critter's art with a "_" in front
+// ("_hmjmps"), and the player's art is shifted into it. A file of that
+// second half is looked for in the appearance picked, and is the game's own
+// where it has none.
+
+// Reads the setting; called as the art is set up.
+bool heroAppearanceInit();
+bool heroAppearanceEnabled();
+
+// Whether the game has races, or styles, to pick from (besides the first).
+bool heroAppearanceHasRaces();
+bool heroAppearanceHasStyles();
+
+// The number of critter arts the game lists, the player's not counted.
+int heroAppearanceCritterCount();
+void heroAppearanceSetCritterCount(int count);
+
+// A critter's art number in the player's range, and back.
+CritterFrameId heroAppearanceFrameId(CritterFrameId frameId);
+CritterFrameId heroAppearanceGameFrameId(CritterFrameId frameId);
+
+// A file of the player's art (art\critters\_*), or null for any other.
+File* heroAppearanceOpen(const char* path, const char* mode);
+
+int heroAppearanceRace();
+int heroAppearanceStyle();
+// Picks a race (its first style) or a style; false when there is none.
+bool heroAppearanceSetRace(int race);
+bool heroAppearanceSetStyle(int style);
+// The first race and style, as a new character has.
+void heroAppearanceSetDefault();
+
+// After a game is started or loaded: the appearance kept with it (sfall's
+// globals HAp_Race and HApStyle), and the player drawn with it.
+void heroAppearanceGameStarted(bool newGame);
+// The player's art number as the game knows it, for the time a save is made.
+void heroAppearanceBeforeSave();
+void heroAppearanceAfterSave();
+
+// The player redrawn with the appearance now picked.
+void heroAppearanceRefreshDude();
+
+// set_hero_race and set_hero_style: the appearance kept for the game's
+// scripts, and the player redrawn.
+void heroAppearanceScriptSetRace(int race);
+void heroAppearanceScriptSetStyle(int style);
+
+// obj_art_fid and art_change_fid_num see the player's art numbers as the
+// game's (but where the mod asks for them as they are).
+int heroAppearanceScriptFid(Object* object, int fid);
+int heroAppearanceScriptSetFrameId(Object* object, int frameId);
+
+// A premade character's appearance (.gcd), after the rest of it.
+void heroAppearanceReadPremade(File* stream);
+void heroAppearanceWritePremade(File* stream);
+
+// The character screen (see character_editor.cc): its background, made
+// from the game's own with room for a view of the character, the race and
+// style headings and, when a character is made, buttons to pick them; and
+// the view, turning.
+void heroAppearanceEditorBuildBackground(const unsigned char* original, unsigned char* background, bool creation);
+void heroAppearanceEditorDrawView(int window, unsigned char* windowBuffer, const unsigned char* background, bool force);
+
+void heroAppearanceExit();
+
+} // namespace fallout
+
+#endif /* FALLOUT_SFALL_HERO_APPEARANCE_H_ */
