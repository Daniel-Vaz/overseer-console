+// SFALL: Hero Appearance: art loaded by name may be another now (the
+// appearance picked has its own); what is not in use is forgotten.
+void artForgetNamedFrameData()
+{
+    for (auto it = gNamedArtCache.begin(); it != gNamedArtCache.end();) {
+        if (it->second.use_count() == 1) {
+            gNamedArtCacheCurrentBytes -= artGetDataSize(it->second->art());
+            it = gNamedArtCache.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
