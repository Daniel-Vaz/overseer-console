+// Opens a file of an archive the game was not started with.
+XFile* xfileOpenInDbase(DBase* dbase, const char* filePath, const char* mode)
+{
+    DFile* dfile = dfileOpen(dbase, filePath, mode);
+    if (dfile == nullptr) {
+        return nullptr;
+    }
+
+    XFile* stream = (XFile*)malloc(sizeof(*stream));
+    if (stream == nullptr) {
+        dfileClose(dfile);
+        return nullptr;
+    }
+
+    memset(stream, 0, sizeof(*stream));
+    stream->type = XFILE_TYPE_DFILE;
+    stream->dfile = dfile;
+    return stream;
+}
