+#include "window_manager.h"
+#include "xfile.h"
+
+namespace fallout {
+
+// Where the player's art is looked for: a folder, or an archive.
+typedef struct AppearanceSource {
+    char folder[COMPAT_MAX_PATH];
+    DBase* dbase;
+} AppearanceSource;
+
+// sfall's setting: 1, or 2 when scripts see the player's art numbers as they
+// are (obj_art_fid, art_change_fid_num).
+static int gHeroAppearanceMode = 0;
+static bool gHeroAppearanceRaces = false;
+static bool gHeroAppearanceStyles = false;
+static int gHeroAppearanceCritterCount = 0;
+static int gHeroAppearanceRace = 0;
+static int gHeroAppearanceStyle = 0;
+
+// The appearance picked, then its race's first style: its folder before its
+// archive, as sfall looks in them.
+static AppearanceSource gHeroAppearanceSources[4];
+static int gHeroAppearanceSourceCount = 0;
+
+static const char* kHeroAppearanceRaceGlobal = "HAp_Race";
+static const char* kHeroAppearanceStyleGlobal = "HApStyle";
+
+static char heroAppearanceSex()
+{
+    return gDude != nullptr && critterGetStat(gDude, STAT_GENDER) == GENDER_FEMALE ? 'F' : 'M';
+}
+
+static void heroAppearanceAppearancePath(char* path, size_t size, int race, int style, const char* extension)
+{
+    snprintf(path, size, "Appearance\\h%cR%02dS%02d%s", heroAppearanceSex(), race, style, extension);
+}
+
+static void heroAppearanceCloseSources()
+{
+    for (int index = 0; index < gHeroAppearanceSourceCount; index++) {
+        if (gHeroAppearanceSources[index].dbase != nullptr) {
+            dbaseClose(gHeroAppearanceSources[index].dbase);
+        }
+    }
+    gHeroAppearanceSourceCount = 0;
+}
+
+// Adds the folder and the archive of an appearance, where there are any.
+static bool heroAppearanceAddSources(int race, int style)
+{
+    bool found = false;
+    char path[COMPAT_MAX_PATH];
+
+    heroAppearanceAppearancePath(path, sizeof(path), race, style, "");
+    if (compat_is_dir(path)) {
+        AppearanceSource* source = &(gHeroAppearanceSources[gHeroAppearanceSourceCount++]);
+        snprintf(source->folder, sizeof(source->folder), "%s", path);
+        source->dbase = nullptr;
+        found = true;
+    }
+
+    heroAppearanceAppearancePath(path, sizeof(path), race, style, ".dat");
+    if (compat_file_exists(path)) {
+        DBase* dbase = dbaseOpen(path);
+        if (dbase != nullptr) {
+            AppearanceSource* source = &(gHeroAppearanceSources[gHeroAppearanceSourceCount++]);
+            source->folder[0] = '\0';
+            source->dbase = dbase;
+        }
+        found = true;
+    }
+
+    return found;
+}
+
+// sfall's LoadHeroDat: false when the appearance has neither folder nor
+// archive (and nothing changes).
+static bool heroAppearanceLoad(int race, int style)
+{
+    char path[COMPAT_MAX_PATH];
+    heroAppearanceAppearancePath(path, sizeof(path), race, style, "");
+    bool exists = compat_is_dir(path);
+    heroAppearanceAppearancePath(path, sizeof(path), race, style, ".dat");
+    exists = exists || compat_file_exists(path);
+    if (!exists) {
+        return false;
+    }
+
+    heroAppearanceCloseSources();
+    heroAppearanceAddSources(race, style);
+    if (style != 0) {
+        heroAppearanceAddSources(race, 0);
+    }
+
+    artCacheFlush();
+    artForgetNamedFrameData();
+    return true;
+}
+
+bool heroAppearanceInit()
+{
+    gHeroAppearanceMode = 0;
+    configGetInt(&gSfallConfig, SFALL_CONFIG_MISC_KEY, "EnableHeroAppearanceMod", &gHeroAppearanceMode);
+    if (gHeroAppearanceMode <= 0) {
+        gHeroAppearanceMode = 0;
+        return true;
+    }
+
+    // Races and styles past the first, of either sex.
+    gHeroAppearanceRaces = compat_is_dir("Appearance\\hmR01S00") || compat_is_dir("Appearance\\hfR01S00")
+        || compat_file_exists("Appearance\\hmR01S00.dat") || compat_file_exists("Appearance\\hfR01S00.dat");
+    gHeroAppearanceStyles = compat_is_dir("Appearance\\hmR00S01") || compat_is_dir("Appearance\\hfR00S01")
+        || compat_file_exists("Appearance\\hmR00S01.dat") || compat_file_exists("Appearance\\hfR00S01.dat");
+
+    debugPrint("Hero Appearance on (races: %d, styles: %d)\n", gHeroAppearanceRaces, gHeroAppearanceStyles);
+    return true;
+}
+
+bool heroAppearanceEnabled()
+{
+    return gHeroAppearanceMode > 0;
+}
+
+bool heroAppearanceHasRaces()
+{
+    return heroAppearanceEnabled() && gHeroAppearanceRaces;
+}
+
+bool heroAppearanceHasStyles()
+{
+    return heroAppearanceEnabled() && gHeroAppearanceStyles;
+}
+
+int heroAppearanceCritterCount()
+{
+    return gHeroAppearanceCritterCount;
+}
+
+void heroAppearanceSetCritterCount(int count)
+{
+    gHeroAppearanceCritterCount = count;
+}
+
+CritterFrameId heroAppearanceFrameId(CritterFrameId frameId)
+{
+    int index = static_cast<int>(frameId);
+    if (!heroAppearanceEnabled() || index < 0 || index >= gHeroAppearanceCritterCount) {
+        return frameId;
+    }
+    return static_cast<CritterFrameId>(index + gHeroAppearanceCritterCount);
+}
+
+CritterFrameId heroAppearanceGameFrameId(CritterFrameId frameId)
+{
+    int index = static_cast<int>(frameId);
+    if (!heroAppearanceEnabled() || index < gHeroAppearanceCritterCount) {
+        return frameId;
+    }
+    return static_cast<CritterFrameId>(index - gHeroAppearanceCritterCount);
+}
+
+File* heroAppearanceOpen(const char* path, const char* mode)
+{
+    if (!heroAppearanceEnabled()) {
+        return nullptr;
+    }
+
+    // As in sfall, the appearance picked is looked in before the game for
+    // any file: its texts and pictures for the character screen too.
+    for (int index = 0; index < gHeroAppearanceSourceCount; index++) {
+        AppearanceSource* source = &(gHeroAppearanceSources[index]);
+        File* stream;
+        if (source->dbase != nullptr) {
+            stream = xfileOpenInDbase(source->dbase, path, mode);
+        } else {
+            char fullPath[COMPAT_MAX_PATH];
+            snprintf(fullPath, sizeof(fullPath), "%s\\%s", source->folder, path);
+            stream = compat_file_exists(fullPath) ? xfileOpen(fullPath, mode) : nullptr;
+        }
+
+        if (stream != nullptr) {
+            return stream;
+        }
+    }
+
+    // The player's art (art\critters\_<name>) the appearance has none of:
+    // the game's own of that name.
+    const char* critters = "art\\critters\\_";
+    size_t length = strlen(critters);
+    if (compat_strnicmp(path, critters, length) != 0) {
+        return nullptr;
+    }
+
+    char gamePath[COMPAT_MAX_PATH];
+    snprintf(gamePath, sizeof(gamePath), "%.*s%s", static_cast<int>(length - 1), path, path + length);
+    return fileOpen(gamePath, mode);
+}
+
+int heroAppearanceRace()
+{
+    return gHeroAppearanceRace;
+}
+
+int heroAppearanceStyle()
+{
+    return gHeroAppearanceStyle;
+}
+
+static void heroAppearanceStoreGlobals()
+{
+    sfall_gl_vars_store(kHeroAppearanceRaceGlobal, gHeroAppearanceRace);
+    sfall_gl_vars_store(kHeroAppearanceStyleGlobal, gHeroAppearanceStyle);
+}
+
+bool heroAppearanceSetRace(int race)
+{
+    if (!heroAppearanceEnabled() || race < 0) {
+        return false;
+    }
+
+    if (!heroAppearanceLoad(race, 0)) {
+        return false;
+    }
+
+    gHeroAppearanceRace = race;
+    gHeroAppearanceStyle = 0;
+    return true;
+}
+
+bool heroAppearanceSetStyle(int style)
+{
+    if (!heroAppearanceEnabled() || style < 0) {
+        return false;
+    }
+
+    if (!heroAppearanceLoad(gHeroAppearanceRace, style)) {
+        return false;
+    }
+
+    gHeroAppearanceStyle = style;
+    return true;
+}
+
+void heroAppearanceSetDefault()
+{
+    gHeroAppearanceRace = 0;
+    gHeroAppearanceStyle = 0;
+    if (heroAppearanceEnabled() && !heroAppearanceLoad(0, 0)) {
+        heroAppearanceCloseSources();
+        artCacheFlush();
+    }
+}
+
+// The player's art number in the player's range (or out of it).
+static void heroAppearanceShiftDude(bool intoRange)
+{
+    if (gDude == nullptr || !heroAppearanceEnabled()) {
+        return;
+    }
+
+    const FrmId frmId = FrmId(gDude);
+    if (frmId.objectType() != OBJ_TYPE_CRITTER) {
+        return;
+    }
+
+    CritterFrameId frameId = frmId.frameId<CritterFrameId>();
+    CritterFrameId shifted = intoRange ? heroAppearanceFrameId(frameId) : heroAppearanceGameFrameId(frameId);
+    if (shifted != frameId) {
+        gDude->fid = FrmId(OBJ_TYPE_CRITTER, static_cast<int>(shifted), frmId.animationType(), frmId.weaponAnimation(), frmId.rotation()).fid();
+    }
+}
+
+void heroAppearanceRefreshDude()
+{
+    if (gDude == nullptr) {
+        return;
+    }
+
+    Rect rect;
+    objectGetRect(gDude, &rect);
+
+    const FrmId dudeFrmId = FrmId(gDude);
+    _proto_dude_update_gender();
+
+    const FrmId frmId = inventoryComputeCritterFrmId(gDude,
+        gDude,
+        critterGetItem2(gDude),
+        critterGetItem1(gDude),
+        critterGetArmor(gDude),
+        interfaceGetCurrentHand(),
+        dudeFrmId.animationType(),
+        dudeFrmId.rotation());
+
+    Rect newRect;
+    objectSetFrmId(gDude, frmId, nullptr);
+    objectGetRect(gDude, &newRect);
+    rectUnion(&rect, &newRect, &rect);
+    tileWindowRefreshRect(&rect, gDude->elevation);
+}
+
+void heroAppearanceGameStarted(bool newGame)
+{
+    if (!heroAppearanceEnabled()) {
+        return;
+    }
+
+    if (newGame) {
+        // What was picked as the character was made.
+        heroAppearanceStoreGlobals();
+    } else {
+        int race = 0;
+        int style = 0;
+        sfall_gl_vars_fetch(kHeroAppearanceRaceGlobal, race);
+        sfall_gl_vars_fetch(kHeroAppearanceStyleGlobal, style);
+        gHeroAppearanceRace = race;
+        gHeroAppearanceStyle = style;
+    }
+
+    if (!heroAppearanceLoad(gHeroAppearanceRace, gHeroAppearanceStyle)) {
+        heroAppearanceCloseSources();
+        artCacheFlush();
+    }
+
+    heroAppearanceShiftDude(true);
+    heroAppearanceRefreshDude();
+}
+
+void heroAppearanceScriptSetRace(int race)
+{
+    if (!heroAppearanceEnabled() || race == gHeroAppearanceRace) {
+        return;
+    }
+
+    heroAppearanceSetRace(race);
+    heroAppearanceStoreGlobals();
+    heroAppearanceRefreshDude();
+}
+
+void heroAppearanceScriptSetStyle(int style)
+{
+    if (!heroAppearanceEnabled() || style == gHeroAppearanceStyle) {
+        return;
+    }
+
+    heroAppearanceSetStyle(style);
+    heroAppearanceStoreGlobals();
+    heroAppearanceRefreshDude();
+}
+
+int heroAppearanceScriptFid(Object* object, int fid)
+{
+    if (gHeroAppearanceMode != 1 || object != gDude) {
+        return fid;
+    }
+
+    const FrmId frmId = FrmId(object);
+    if (frmId.objectType() != OBJ_TYPE_CRITTER) {
+        return fid;
+    }
+
+    CritterFrameId frameId = frmId.frameId<CritterFrameId>();
+    return FrmId(OBJ_TYPE_CRITTER, static_cast<int>(heroAppearanceGameFrameId(frameId)), frmId.animationType(), frmId.weaponAnimation(), frmId.rotation()).fid();
+}
+
+int heroAppearanceScriptSetFrameId(Object* object, int frameId)
+{
+    if (gHeroAppearanceMode != 1 || object != gDude || FrmId(object).objectType() != OBJ_TYPE_CRITTER) {
+        return frameId;
+    }
+
+    return static_cast<int>(heroAppearanceFrameId(static_cast<CritterFrameId>(frameId)));
+}
+
+void heroAppearanceBeforeSave()
+{
+    heroAppearanceShiftDude(false);
+}
+
+void heroAppearanceAfterSave()
+{
+    heroAppearanceShiftDude(true);
+}
+
+void heroAppearanceReadPremade(File* stream)
+{
+    if (!heroAppearanceEnabled()) {
+        return;
+    }
+
+    // Two numbers after the rest, where sfall wrote them.
+    int race = 0;
+    int style = 0;
+    int value;
+    if (fileReadInt32(stream, &value) != -1 && value >= 0 && value < 100) {
+        race = value;
+        if (fileReadInt32(stream, &value) != -1 && value >= 0 && value < 100) {
+            style = value;
+        }
+    }
+
+    if (heroAppearanceLoad(race, style)) {
+        gHeroAppearanceRace = race;
+        gHeroAppearanceStyle = style;
+    } else if (heroAppearanceLoad(race, 0)) {
+        gHeroAppearanceRace = race;
+        gHeroAppearanceStyle = 0;
+    } else {
+        heroAppearanceSetDefault();
+    }
+}
+
+void heroAppearanceWritePremade(File* stream)
+{
+    if (!heroAppearanceEnabled()) {
+        return;
+    }
+
+    if (fileWriteInt32(stream, gHeroAppearanceRace) != -1) {
+        fileWriteInt32(stream, gHeroAppearanceStyle);
+    }
+}
+
+// Copies a w x h part of src (src pitch) at (sx, sy) to dest (dest pitch,
+// 640 for the screen) at (dx, dy), leaving out the pixels of colour `skip`
+// (-1 for none).
+static void heroAppearanceCopy(int width, int height, const unsigned char* src, int srcPitch, int sx, int sy, unsigned char* dest, int dx, int dy, int skip = -1, int destPitch = 640)
+{
+    for (int y = 0; y < height; y++) {
+        const unsigned char* from = src + (sy + y) * srcPitch + sx;
+        unsigned char* to = dest + (dy + y) * destPitch + dx;
+        for (int x = 0; x < width; x++) {
+            if (skip < 0 || from[x] != skip) {
+                to[x] = from[x];
+            }
+        }
+    }
+}
+
+void heroAppearanceEditorBuildBackground(const unsigned char* original, unsigned char* background, bool creation)
+{
+    // As sfall makes it when a mod brings no picture of its own.
+    memcpy(background, original, 640 * 480);
+
+    // The tag skills counter to the right, a blank part of the bar where it was.
+    heroAppearanceCopy(38, 26, original, 640, 519, 228, background, 519 + 36, 228);
+    heroAppearanceCopy(38, 26, original, 640, 460, 228, background, 519, 228);
+
+    // The button rail shifted along, and a shadow for the race and style buttons.
+    heroAppearanceCopy(36, 258, original, 640, 332, 0, background, 408, 0);
+    heroAppearanceCopy(6, 32, original, 640, 331, 233, background, 330, 6);
+
+    // The view's window, out of the "use item on" window's.
+    FrmImage useOn;
+    if (useOn.lock(FrmId(OBJ_TYPE_INTERFACE, 113))) {
+        int pitch = useOn.getWidth();
+        heroAppearanceCopy(81, 132, useOn.getData(), pitch, 163, 20, background, 331, 63);
+        heroAppearanceCopy(79, 31, useOn.getData(), pitch, 154, 228, background, 331, 32);
+        heroAppearanceCopy(79, 30, useOn.getData(), pitch, 158, 236, background, 331, 195);
+        useOn.unlock();
+    }
+
+    // The race and style buttons, out of the sex button cut to its mask.
+    FrmImage sexOff;
+    FrmImage sexMask;
+    if (sexOff.lock(FrmId(OBJ_TYPE_INTERFACE, 188)) && sexMask.lock(FrmId(OBJ_TYPE_INTERFACE, 187))) {
+        unsigned char button[80 * 32] = { 0 };
+        heroAppearanceCopy(std::min(80, sexOff.getWidth()), std::min(32, sexOff.getHeight()), sexOff.getData(), sexOff.getWidth(), 0, 0, button, 0, 0, -1, 80);
+        for (int y = 0; y < std::min(28, sexMask.getHeight()); y++) {
+            for (int x = 0; x < std::min(80, sexMask.getWidth()); x++) {
+                unsigned char pixel = sexMask.getData()[y * sexMask.getWidth() + x];
+                if (pixel != 0x39) {
+                    button[y * 80 + x] = pixel;
+                }
+            }
+        }
+        for (int y = 29; y < 32; y++) {
+            for (int x = 76; x < 80; x++) {
+                button[y * 80 + x] = 0;
+            }
+        }
+
+        for (int y = 0; y < 32; y++) {
+            for (int x = 0; x < 80; x++) {
+                unsigned char pixel = button[y * 80 + x];
+                if (pixel != 0) {
+                    background[y * 640 + 332 + x] = pixel;
+                    background[(225 + y) * 640 + 332 + x] = pixel;
+                }
+            }
+        }
+    }
+    sexOff.unlock();
+    sexMask.unlock();
+
+    // Behind the buttons that pick them, when a character is made.
+    if (creation && (heroAppearanceHasRaces() || heroAppearanceHasStyles())) {
+        FrmImage pickCharacter;
+        if (pickCharacter.lock(FrmId(OBJ_TYPE_INTERFACE, 174))) {
+            int pitch = pickCharacter.getWidth();
+            if (heroAppearanceHasRaces()) {
+                heroAppearanceCopy(69, 20, pickCharacter.getData(), pitch, 281, 319, background, 337, 36);
+            }
+            if (heroAppearanceHasStyles()) {
+                heroAppearanceCopy(69, 20, pickCharacter.getData(), pitch, 281, 319, background, 337, 198);
+            }
+            pickCharacter.unlock();
+        }
+    }
+
+    // RACE and STYLE, in the game's words where it has them.
+    const char* race = "Race";
+    const char* style = "Style";
+    MessageList messageList;
+    bool loaded = messageListInit(&messageList) && messageListLoad(&messageList, "game\\AppIface.msg");
+    MessageListItem item;
+    if (loaded) {
+        item.num = 100;
+        if (messageListGetItem(&messageList, &item)) {
+            race = item.text;
+        }
+        MessageListItem styleItem;
+        styleItem.num = 101;
+        if (messageListGetItem(&messageList, &styleItem)) {
+            style = styleItem.text;
+        }
+    }
+
+    int oldFont = fontGetCurrent();
+    fontSetCurrent(103);
+    fontDrawText(background + 640 * 6 + 372 - fontGetStringWidth(race) / 2, race, 640, 640, COLOR_DARK_YELLOW);
+    fontDrawText(background + 640 * 231 + 372 - fontGetStringWidth(style) / 2, style, 640, 640, COLOR_DARK_YELLOW);
+    fontSetCurrent(oldFont);
+
+    if (loaded) {
+        messageListFree(&messageList);
+    }
+}
+
+// The view of the character turns a step at a time, as fast as on the
+// inventory screen.
+static constexpr unsigned int kHeroAppearanceViewTurnDelay = 166;
+static constexpr int kHeroAppearanceViewX = 338;
+static constexpr int kHeroAppearanceViewY = 78;
+static constexpr int kHeroAppearanceViewWidth = 70;
+static constexpr int kHeroAppearanceViewHeight = 102;
+
+void heroAppearanceEditorDrawView(int window, unsigned char* windowBuffer, const unsigned char* background, bool force)
+{
+    static unsigned int lastTurn = 0;
+    static int rotation = 0;
+
+    if (gDude == nullptr) {
+        return;
+    }
+
+    unsigned int now = getTicks();
+    if (!force && getTicksBetween(now, lastTurn) < kHeroAppearanceViewTurnDelay) {
+        return;
+    }
+
+    if (!force) {
+        rotation = (rotation + 1) % ROTATION_COUNT;
+    }
+    lastTurn = now;
+
+    unsigned char* view = windowBuffer + 640 * kHeroAppearanceViewY + kHeroAppearanceViewX;
+    blitBufferToBuffer(background + 640 * kHeroAppearanceViewY + kHeroAppearanceViewX,
+        kHeroAppearanceViewWidth,
+        kHeroAppearanceViewHeight,
+        640,
+        view,
+        640);
+
+    // The player standing, with what they wear and hold.
+    const FrmId dudeFrmId = FrmId(gDude);
+    const FrmId standing = FrmId(OBJ_TYPE_CRITTER, dudeFrmId.frameId(), ANIM_STAND, dudeFrmId.weaponAnimation(), static_cast<Rotation>(rotation));
+    FrmImage art;
+    if (art.lock(standing, 0, static_cast<Rotation>(rotation))) {
+        int width = std::min(art.getWidth(), kHeroAppearanceViewWidth);
+        int height = std::min(art.getHeight(), kHeroAppearanceViewHeight);
+        int x = (kHeroAppearanceViewWidth - width) / 2;
+        int y = (kHeroAppearanceViewHeight - height) / 2;
+        blitBufferToBufferTrans(art.getData() + (art.getHeight() - height) / 2 * art.getWidth() + (art.getWidth() - width) / 2,
+            width,
+            height,
+            art.getWidth(),
+            view + 640 * y + x,
+            640);
+        art.unlock();
+    }
+
+    Rect rect = { kHeroAppearanceViewX, kHeroAppearanceViewY, kHeroAppearanceViewX + kHeroAppearanceViewWidth - 1, kHeroAppearanceViewY + kHeroAppearanceViewHeight - 1 };
+    windowRefreshRect(window, &rect);
+}
+
+void heroAppearanceExit()
+{
+    heroAppearanceCloseSources();
+}
+
+} // namespace fallout
