+            name[ART_NAME_SIZE - 1] = '\0';
+        }
+
+        gArtListDescriptions[OBJ_TYPE_CRITTER].fileNames = names;
+        gArtListDescriptions[OBJ_TYPE_CRITTER].fileNamesLength = critterCount * 2;
+    }
