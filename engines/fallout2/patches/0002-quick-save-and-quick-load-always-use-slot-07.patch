+// Whether slot 07 holds a quick save to load: 1 it does, 0 it is empty, -1
+// what is there cannot be read. Looked at before anything of the game in
+// progress is let go of.
+static int lsgQuickSlotState()
+{
+    snprintf(_gmpath, sizeof(_gmpath), "%s\\%s%.2d\\%s", "SAVEGAME", "SLOT", kQuickSaveSlot + 1, "SAVE.DAT");
+    _flptr = fileOpen(_gmpath, "rb");
+    if (_flptr == nullptr) {
+        return 0;
+    }
+
+    int state = lsgLoadHeaderInSlot(kQuickSaveSlot) == -1 ? -1 : 1;
+    fileClose(_flptr);
+    return state;
+}
