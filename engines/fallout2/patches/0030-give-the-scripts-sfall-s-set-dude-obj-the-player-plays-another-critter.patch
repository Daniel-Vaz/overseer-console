+#include "display_monitor.h"
+#include "interface.h"
+#include "inventory.h"
+#include "item.h"
+#include "map.h"
+#include "message.h"
+#include "object.h"
+#include "party_member.h"
+#include "perk.h"
+#include "proto.h"
+#include "skill.h"
+#include "stat.h"
+#include "trait.h"
+
+namespace fallout {
+
+// What sfall's SaveRealDudeState keeps of the player while another critter is
+// played as the player.
+static struct {
+    Object* obj = nullptr;
+    CritterFrameId artVaultGuy;
+    std::vector<unsigned char> hands;
+    Trait traits[2];
+    std::vector<unsigned char> perks;
+    char name[64];
+    int pcStats[PC_STAT_COUNT];
+    int lastLevel;
+    unsigned char freePerks;
+    int sneakWorking;
+    Skill taggedSkills[NUM_TAGGED_SKILLS];
+    std::vector<int> addictions;
+    bool saved = false;
+} gRealDude;
+
+static bool gControlling = false;
+static int gDelayedExperience = 0;
+
+bool partyControlActive()
+{
+    return gControlling;
+}
+
+Object* partyControlRealDude()
+{
+    return gRealDude.obj != nullptr ? gRealDude.obj : gDude;
+}
+
+char* partyControlRealDudeName(Object* obj)
+{
+    return gControlling && obj == gRealDude.obj ? gRealDude.name : nullptr;
+}
+
+static void saveRealDudeState()
+{
+    gRealDude.obj = gDude;
+    gRealDude.artVaultGuy = _art_vault_guy_num;
+    gRealDude.hands = interfaceSaveHands();
+    traitsGetSelected(&gRealDude.traits[0], &gRealDude.traits[1]);
+    gRealDude.perks.resize(perkRanksSize());
+    perkGetDudeRanks(gRealDude.perks.data());
+    snprintf(gRealDude.name, sizeof(gRealDude.name), "%s", critterGetName(gDude));
+    pcStatsCopy(gRealDude.pcStats);
+    characterEditorGetLevelState(&gRealDude.lastLevel, &gRealDude.freePerks);
+    gRealDude.sneakWorking = dudeGetSneakWorking();
+    skillsGetTagged(gRealDude.taggedSkills, NUM_TAGGED_SKILLS);
+    gRealDude.addictions = drugsAddictionValues();
+    gRealDude.saved = true;
+}
+
+// sfall's SetCurrentDude: the critter takes the player's place, with its own
+// name, perks (a party member's, else none), level, and addictions, and none
+// of the player's traits, tagged skills, experience or skill points.
+static void setCurrentDude(Object* critter)
+{
+    char name[64];
+    snprintf(name, sizeof(name), "%s", critterGetName(critter));
+
+    Skill tags[NUM_TAGGED_SKILLS];
+    for (int index = 0; index < NUM_TAGGED_SKILLS; index++) {
+        tags[index] = SKILL_INVALID;
+    }
+    skillsSetTagged(tags, NUM_TAGGED_SKILLS);
+
+    traitsSetSelected(TRAIT_INVALID, TRAIT_INVALID);
+
+    std::vector<unsigned char> perks(perkRanksSize(), 0);
+    bool partyMember = perkGetPartyMemberRanks(critter, perks.data());
+    perkSetDudeRanks(perks.data());
+
+    int level = partyMember ? partyMemberGetCurrentLevel(critter) : 0;
+    int stats[PC_STAT_COUNT];
+    pcStatsCopy(stats);
+    stats[PC_STAT_LEVEL] = level;
+    stats[PC_STAT_EXPERIENCE] = 0;
+    stats[PC_STAT_UNSPENT_SKILL_POINTS] = 0;
+    pcStatsPut(stats);
+    characterEditorSetLevelState(level, 0);
+
+    dudeSetName(name);
+    dudeSetSneakWorking(0);
+
+    // The hand held ready: the one whose weapon it is seen with.
+    Object* left = critterGetItem1(critter);
+    WeaponAnimation shown = FrmId(critter).weaponAnimation();
+    bool leftReady = left != nullptr && itemGetType(left) == ITEM_TYPE_WEAPON && weaponGetAnimationCode(left) == shown;
+    interfaceSetCurrentHand(leftReady ? HAND_LEFT : HAND_RIGHT);
+
+    drugsSetAddictionValuesFor(critter);
+
+    // Last, the pointers to the player.
+    combatSetTurnObject(critter);
+    gDude = critter;
+    inventorySetDude(critter);
+    _art_vault_guy_num = FrmId(critter).frameId<CritterFrameId>();
+
+    gControlling = true;
+    gDelayedExperience = 0;
+
+    interfaceBarRefresh();
+}
+
+static void restoreRealDudeState(bool redraw)
+{
+    if (gRealDude.obj == nullptr) {
+        return;
+    }
+
+    gDude = gRealDude.obj;
+    inventorySetDude(gRealDude.obj);
+    _art_vault_guy_num = gRealDude.artVaultGuy;
+
+    interfaceRestoreHands(gRealDude.hands);
+    traitsSetSelected(gRealDude.traits[0], gRealDude.traits[1]);
+    perkSetDudeRanks(gRealDude.perks.data());
+    dudeSetName(gRealDude.name);
+    pcStatsPut(gRealDude.pcStats);
+    characterEditorSetLevelState(gRealDude.lastLevel, gRealDude.freePerks);
+    dudeSetSneakWorking(gRealDude.sneakWorking);
+    skillsSetTagged(gRealDude.taggedSkills, NUM_TAGGED_SKILLS);
+    drugsSetAddictionValues(gRealDude.addictions);
+
+    gRealDude.saved = false;
+    gControlling = false;
+
+    if (gDelayedExperience > 0) {
+        int xp = gDelayedExperience;
+        gDelayedExperience = 0;
+        pcAddExperience(xp);
+    }
+
+    if (redraw) {
+        interfaceBarRefresh();
+    }
+}
+
+void partyControlSwitchTo(Object* critter)
+{
+    if (gControlling && (critter == nullptr || critter == gRealDude.obj)) {
+        restoreRealDudeState(critter != nullptr);
+    }
+
+    if (critter != nullptr && critter != partyControlRealDude() && critter != gDude) {
+        if (!gControlling && !gRealDude.saved) {
+            saveRealDudeState();
+        }
+        setCurrentDude(critter);
+    }
+}
+
+void partyControlReset()
+{
+    if (gControlling) {
+        restoreRealDudeState(false);
+    }
+    gRealDude.obj = nullptr;
+    gRealDude.saved = false;
+    gDelayedExperience = 0;
+}
+
+bool partyControlDelayExperience(int xp)
+{
+    if (!gControlling) {
+        return false;
+    }
+    gDelayedExperience += xp;
+    return true;
+}
+
+bool partyControlRealDudePerk(Object* obj, int perk, int* rankPtr)
+{
+    if (!gControlling || obj != gRealDude.obj) {
+        return false;
+    }
+
+    // The player's own ranks, kept as the engine keeps them: one int a perk.
+    int rank = 0;
+    if (perk >= 0 && static_cast<size_t>(perk + 1) * sizeof(int) <= gRealDude.perks.size()) {
+        memcpy(&rank, gRealDude.perks.data() + perk * sizeof(int), sizeof(int));
+    }
+    *rankPtr = rank;
+    return true;
+}
+
+bool partyControlRealDudeTrait(Object* obj, int trait, int* selectedPtr)
+{
+    if (!gControlling || obj != gRealDude.obj) {
+        return false;
+    }
+    *selectedPtr = (trait == gRealDude.traits[0] || trait == gRealDude.traits[1]) ? 1 : 0;
+    return true;
+}
+
+bool partyControlCanReady(Object* item)
+{
+    if (!gControlling || item == nullptr || itemGetType(item) != ITEM_TYPE_WEAPON) {
+        return true;
+    }
+
+    CritterFrmId fid(FrmId(gDude).frameId<CritterFrameId>(), ANIM_STAND, weaponGetAnimationCode(item), ROTATION_NE);
+    if (fid.exist()) {
+        return true;
+    }
+
+    // proto.msg 675: "I can't do that."
+    MessageListItem messageListItem;
+    messageListItem.num = 675;
+    if (messageListGetItem(&gProtoMessageList, &messageListItem)) {
+        displayMonitorAddMessage(messageListItem.text);
+    }
+    return false;
+}
+
+} // namespace fallout
