@@ -0,0 +1,35 @@
+#ifndef FALLOUT_SFALL_PARTY_CONTROL_H_
+#define FALLOUT_SFALL_PARTY_CONTROL_H_
+
+#include "obj_types.h"
+
+namespace fallout {
+
+// sfall's set_dude_obj (its PartyControl): the player plays another critter,
+// a party member in combat as gl_partycontrol has it, which then stands as
+// the player (gDude) until control goes back to the player's own.
+
+// Whether another critter is being played as the player.
+bool partyControlActive();
+// The player's own critter, whichever is being played.
+Object* partyControlRealDude();
+// The player's own name while another critter is played, for that critter;
+// null otherwise.
+char* partyControlRealDudeName(Object* obj);
+// Plays `critter`; null, or the player's own, gives control back.
+void partyControlSwitchTo(Object* critter);
+void partyControlReset();
+// Experience given while another critter is played is the player's, given
+// when control comes back: true where it was put aside so.
+bool partyControlDelayExperience(int xp);
+// What scripts are told of the player's own perks and traits while another
+// critter is played: false where it is not the player's own they ask of.
+bool partyControlRealDudePerk(Object* obj, int perk, int* rankPtr);
+bool partyControlRealDudeTrait(Object* obj, int trait, int* selectedPtr);
+// Whether the critter played can hold `item` ready: one with no pictures of
+// itself with that weapon cannot ("I can't do that").
+bool partyControlCanReady(Object* item);
+
+} // namespace fallout
+
+#endif /* FALLOUT_SFALL_PARTY_CONTROL_H_ */
