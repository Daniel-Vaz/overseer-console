+// The addiction variables, each once: the engine's drugs', then the file's.
+static std::vector<int> drugsAddictionGvars()
+{
+    std::vector<int> gvars;
+    auto add = [&](int gvar) {
+        if (gvar > 0 && gvar < gGameGlobalVarsLength && std::find(gvars.begin(), gvars.end(), gvar) == gvars.end()) {
+            gvars.push_back(gvar);
+        }
+    };
+    for (int index = 0; index < ADDICTION_COUNT; index++) {
+        add(gDrugDescriptions[index].gvar);
+    }
+    for (auto& drug : gSfallDrugs) {
+        add(drug.gvar);
+    }
+    return gvars;
+}
+
+std::vector<int> drugsAddictionValues()
+{
+    std::vector<int> values;
+    for (int gvar : drugsAddictionGvars()) {
+        values.push_back(gGameGlobalVars[gvar]);
+    }
+    return values;
+}
+
+void drugsSetAddictionValues(const std::vector<int>& values)
+{
+    std::vector<int> gvars = drugsAddictionGvars();
+    for (size_t index = 0; index < gvars.size() && index < values.size(); index++) {
+        gGameGlobalVars[gvars[index]] = values[index];
+    }
+}
+
+// sfall's CheckAddictByPid: a critter is addicted to a drug while it has a
+// withdrawal for it waiting.
+static bool critterIsAddictedTo(Object* critter, int pid)
+{
+    WithdrawalEvent* event = (WithdrawalEvent*)queueFindFirstEvent(critter, EVENT_TYPE_WITHDRAWAL);
+    while (event != nullptr) {
+        if (event->pid == pid) {
+            return true;
+        }
+        event = (WithdrawalEvent*)queueFindNextEvent(critter, EVENT_TYPE_WITHDRAWAL);
+    }
+    return false;
+}
+
+bool drugsSetAddictionValuesFor(Object* critter)
+{
+    for (int gvar : drugsAddictionGvars()) {
+        gGameGlobalVars[gvar] = 0;
+    }
+
+    bool addicted = false;
+    for (int index = 0; index < ADDICTION_COUNT; index++) {
+        if (critterIsAddictedTo(critter, gDrugDescriptions[index].drugPid)) {
+            gGameGlobalVars[gDrugDescriptions[index].gvar] = 1;
+            addicted = true;
+        }
+    }
+    for (auto& drug : gSfallDrugs) {
+        if (drug.gvar > 0 && drug.gvar < gGameGlobalVarsLength && critterIsAddictedTo(critter, drug.pid)) {
+            gGameGlobalVars[drug.gvar] = 1;
+            addicted = true;
+        }
+    }
+    return addicted;
+}
+
 } // namespace fallout
