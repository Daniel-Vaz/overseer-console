     gHpPerLevel = kDefaultHpPerLevel;
     gBaseHitChanceMod = { -1, kDefaultHitChanceMaximum, 0 };
     gCritterHitChanceMods.clear();
+    for (auto& mods : gKnockbackMods) {
+        mods.clear();
+    }
+}
+
+void sfallSetKnockbackMod(Object* object, KnockbackModKind kind, int type, float value)
+{
+    if (object == nullptr) {
+        return;
+    }
+
+    // As in sfall: by an id that stays the object's.
+    KnockbackMod mod = { scriptsSetUniqueObjectId(object), type, value };
+    auto& mods = gKnockbackMods[static_cast<int>(kind)];
+    for (KnockbackMod& entry : mods) {
+        if (entry.objectId == mod.objectId) {
+            entry = mod;
+            return;
+        }
+    }
+    mods.push_back(mod);
+}
+
+void sfallRemoveKnockbackMod(Object* object, KnockbackModKind kind)
+{
+    if (object == nullptr) {
+        return;
+    }
+
+    auto& mods = gKnockbackMods[static_cast<int>(kind)];
+    mods.erase(std::remove_if(mods.begin(), mods.end(), [object](const KnockbackMod& entry) {
+        return entry.objectId == object->id;
+    }),
+        mods.end());
+}
+
+static double applyKnockbackMods(KnockbackModKind kind, Object* object, double value)
+{
+    if (object == nullptr) {
+        return value;
+    }
+
+    for (const KnockbackMod& entry : gKnockbackMods[static_cast<int>(kind)]) {
+        if (entry.objectId == object->id) {
+            if (entry.type == 0) {
+                return entry.value;
+            }
+            if (entry.type == 1) {
+                return value * entry.value;
+            }
+            return value;
+        }
+    }
+    return value;
+}
+
+int sfallKnockbackDistance(int damage, int divisor, Object* weapon, Object* attacker, Object* target)
+{
+    double distance = static_cast<double>(damage) / divisor;
+    distance = applyKnockbackMods(KnockbackModKind::Weapon, weapon, distance);
+    distance = applyKnockbackMods(KnockbackModKind::Attacker, attacker, distance);
+    distance = applyKnockbackMods(KnockbackModKind::Target, target, distance);
+    return static_cast<int>(std::floor(distance));
+}
+
+void sfallApplyHeaveHoFix()
+{
+    gHeaveHoFixApplied = true;
+    perkSetProperty(PERK_HEAVE_HO, PerkProperty::Strength, 0);
+}
+
+bool sfallHeaveHoFixApplied()
+{
+    return gHeaveHoFixApplied;
 }
 
