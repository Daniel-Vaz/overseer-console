+// set_weapon_knockback, set_target_knockback, set_attacker_knockback
+template <KnockbackModKind kind>
+static void op_set_knockback(Program* program)
+{
+    ProgramValue value = programStackPopValue(program);
+    int modType = programStackPopInteger(program);
+    Object* object = static_cast<Object*>(programStackPopPointer(program));
+    if (object == nullptr) {
+        return;
+    }
+
+    const ProtoId protoId = object;
+    ObjectType type = protoId.objectType();
+    if (kind == KnockbackModKind::Weapon ? type != OBJ_TYPE_ITEM : type != OBJ_TYPE_CRITTER) {
+        programPrintError("set_*_knockback: the object is not %s", kind == KnockbackModKind::Weapon ? "an item" : "a critter");
+        return;
+    }
+
+    sfallSetKnockbackMod(object, kind, modType, value.isFloat() ? value.floatValue : static_cast<float>(value.integerValue));
+}
+
+// remove_weapon_knockback, remove_target_knockback, remove_attacker_knockback
+template <KnockbackModKind kind>
+static void op_remove_knockback(Program* program)
+{
+    Object* object = static_cast<Object*>(programStackPopPointer(program));
+    sfallRemoveKnockbackMod(object, kind);
+}
+
+// get_viewport_x, get_viewport_y: the part of the world map in view.
+static void op_get_viewport_x(Program* program)
+{
+    int x;
+    int y;
+    wmGetWorldOffset(&x, &y);
+    programStackPushInteger(program, x);
+}
+
+static void op_get_viewport_y(Program* program)
+{
+    int x;
+    int y;
+    wmGetWorldOffset(&x, &y);
+    programStackPushInteger(program, y);
+}
+
+static void op_set_viewport_x(Program* program)
+{
+    int value = programStackPopInteger(program);
+    int x;
+    int y;
+    wmGetWorldOffset(&x, &y);
+    wmSetWorldOffset(value, y);
+}
+
+static void op_set_viewport_y(Program* program)
+{
+    int value = programStackPopInteger(program);
+    int x;
+    int y;
+    wmGetWorldOffset(&x, &y);
+    wmSetWorldOffset(x, value);
+}
+
+// remove_trait: the player's second trait, if any, takes the place of the first.
+static void op_remove_trait(Program* program)
+{
+    int trait = programStackPopInteger(program);
+    if (trait < 0) {
+        return;
+    }
+
+    Trait trait1;
+    Trait trait2;
+    traitsGetSelected(&trait1, &trait2);
+    if (trait == trait1) {
+        traitsSetSelected(trait2, TRAIT_INVALID);
+    } else if (trait == trait2) {
+        traitsSetSelected(trait1, TRAIT_INVALID);
+    }
+}
+
+static void op_apply_heaveho_fix(Program* program)
+{
+    sfallApplyHeaveHoFix();
+}
