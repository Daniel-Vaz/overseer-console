+// add_trait: a trait for the player, in a free one of its two places. (CE has
+// no set_dude_obj, so the dude is always the player.)
+void mf_add_trait(OpcodeContext& ctx)
+{
+    int trait = ctx.arg(0).asInt();
+    if (!traitIsValid(trait)) {
+        ctx.printError("%s() - invalid trait ID.", ctx.name());
+        return;
+    }
+
+    Trait trait1;
+    Trait trait2;
+    traitsGetSelected(&trait1, &trait2);
+    if (trait1 == TRAIT_INVALID) {
+        traitsSetSelected(static_cast<Trait>(trait), trait2);
+    } else if (trait1 != trait && trait2 == TRAIT_INVALID) {
+        traitsSetSelected(trait1, static_cast<Trait>(trait));
+    } else {
+        ctx.printError("%s() - cannot add the trait ID: %d", ctx.name(), trait);
+    }
+}
