--- a/src/sfall_kb_helpers.h
+++ b/src/sfall_kb_helpers.h
@@ -23,6 +23,10 @@ int sfall_kb_handle_key_pressed(int sdlScanCode, bool pressed);
 // of for them alone, as the keyboard's own are told of (HOOK_KEYPRESS).
 void sfall_kb_handle_page_keys();
 
+// Overseer Console: the game was saved or loaded; the keys the page holds are
+// let go of and pressed again for the scripts once it is back on the map.
+void sfall_kb_page_keys_stale();
+
 } // namespace fallout
 
 #endif /* FALLOUT_SFALL_KB_HELPERS_H_ */
