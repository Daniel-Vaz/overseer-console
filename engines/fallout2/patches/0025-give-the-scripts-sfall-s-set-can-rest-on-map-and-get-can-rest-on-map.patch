+// set_can_rest_on_map(map, elevation, can): -1 for every elevation.
+void mf_set_rest_on_map(OpcodeContext& ctx)
+{
+    int map = ctx.arg(0).asInt();
+    int elevation = ctx.arg(1).asInt();
+    if (map < 0 || elevation < -1 || elevation > 2) {
+        ctx.printError("%s() - invalid map number or elevation.", ctx.name());
+        ctx.setReturn(-1);
+        return;
+    }
+    sfallRestSet(map, elevation, ctx.arg(2).asInt() != 0);
+}
+
+// get_can_rest_on_map(map, elevation): 1 or 0 where a script set it, -1 where maps.txt has its way.
+void mf_get_rest_on_map(OpcodeContext& ctx)
+{
+    int elevation = ctx.arg(1).asInt();
+    if (elevation < 0 || elevation > 2) {
+        ctx.printError("%s() - invalid map elevation.", ctx.name());
+        ctx.setReturn(-1);
+        return;
+    }
+    ctx.setReturn(sfallRestGet(ctx.arg(0).asInt(), elevation));
+}
