@@ -0,0 +1,22 @@
+#ifndef FALLOUT_SFALL_REST_H_
+#define FALLOUT_SFALL_REST_H_
+
+#include "db.h"
+
+namespace fallout {
+
+// sfall's set_can_rest_on_map/get_can_rest_on_map: where the player may rest,
+// map by map and elevation by elevation, over what maps.txt says. Kept in
+// sfalldb.sav, in sfall's layout.
+
+void sfallRestReset();
+// `elevation` -1: every elevation of the map.
+void sfallRestSet(int map, int elevation, bool canRest);
+// 1 or 0 where a script said so, -1 where maps.txt has its way.
+int sfallRestGet(int map, int elevation);
+bool sfallDbSave(File* stream);
+bool sfallDbLoad(File* stream);
+
+} // namespace fallout
+
+#endif /* FALLOUT_SFALL_REST_H_ */
