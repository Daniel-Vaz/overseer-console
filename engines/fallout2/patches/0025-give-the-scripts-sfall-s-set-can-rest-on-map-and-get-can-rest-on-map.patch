diff --git a/src/sfall_rest.cc b/src/sfall_rest.cc
new file mode 100644
index 0000000..8c672d6
--- /dev/null
+++ b/src/sfall_rest.cc
@@ -0,0 +1,106 @@
+#include "sfall_rest.h"
+
+#include <array>
+#include <map>
+
+namespace fallout {
+
+// By map: one value for each elevation (and one sfall leaves unused), -1 for
+// none set. Ordered, so that a save is written the same way each time.
+static std::map<int, std::array<signed char, 4>> gRestByMap;
+
+void sfallRestReset()
+{
+    gRestByMap.clear();
+}
+
+void sfallRestSet(int map, int elevation, bool canRest)
+{
+    auto it = gRestByMap.find(map);
+    if (it == gRestByMap.end()) {
+        it = gRestByMap.emplace(map, std::array<signed char, 4> { -1, -1, -1, -1 }).first;
+    }
+
+    if (elevation == -1) {
+        for (int index = 0; index < 3; index++) {
+            it->second[index] = canRest ? 1 : 0;
+        }
+    } else if (elevation >= 0 && elevation < 3) {
+        it->second[elevation] = canRest ? 1 : 0;
+    }
+}
+
+int sfallRestGet(int map, int elevation)
+{
+    if (elevation < 0 || elevation >= 3) {
+        return -1;
+    }
+
+    auto it = gRestByMap.find(map);
+    return it != gRestByMap.end() ? it->second[elevation] : -1;
+}
+
+// sfall writes its files as the program holds its numbers: low byte first.
+static bool writeInt(File* stream, int value)
+{
+    unsigned char bytes[4] = {
+        static_cast<unsigned char>(value),
+        static_cast<unsigned char>(value >> 8),
+        static_cast<unsigned char>(value >> 16),
+        static_cast<unsigned char>(value >> 24),
+    };
+    return fileWrite(bytes, 1, 4, stream) == 4;
+}
+
+static bool readInt(File* stream, int* value)
+{
+    unsigned char bytes[4];
+    if (fileRead(bytes, 1, 4, stream) != 4) {
+        return false;
+    }
+    *value = bytes[0] | (bytes[1] << 8) | (bytes[2] << 16) | (bytes[3] << 24);
+    return true;
+}
+
+// sfalldb.sav as sfall writes it: Worldmap::SaveData (the number of maps,
+// then each one's number and its four bytes), CritterStats::SaveStatData (the
+// critters' base and bonus stats it keeps: none here), and a last marker with
+// the version of sfall.
+bool sfallDbSave(File* stream)
+{
+    if (!writeInt(stream, static_cast<int>(gRestByMap.size()))) {
+        return false;
+    }
+
+    for (auto& [map, levels] : gRestByMap) {
+        if (!writeInt(stream, map) || fileWrite(levels.data(), 1, levels.size(), stream) != levels.size()) {
+            return false;
+        }
+    }
+
+    return writeInt(stream, 0) && writeInt(stream, 0) && writeInt(stream, 0xCC | (4 << 8) | (5 << 16) | (1 << 24));
+}
+
+bool sfallDbLoad(File* stream)
+{
+    gRestByMap.clear();
+
+    int count;
+    if (!readInt(stream, &count)) {
+        return true;
+    }
+
+    for (int index = 0; index < count; index++) {
+        int map;
+        std::array<signed char, 4> levels;
+        if (!readInt(stream, &map) || fileRead(levels.data(), 1, levels.size(), stream) != levels.size()) {
+            return false;
+        }
+        gRestByMap[map] = levels;
+    }
+
+    // What follows is sfall's critters' stats, which this engine does not keep.
+    return true;
+}
+
+} // namespace fallout
