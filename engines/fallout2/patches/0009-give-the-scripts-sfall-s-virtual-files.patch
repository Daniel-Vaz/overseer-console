+// sfall writes and reads numbers high byte first.
+static void writeBytes(int id, unsigned int value, int length)
+{
+    SfallFile* file = fileOf(id);
+    if (file == nullptr || file->pos + length > static_cast<int>(file->data.size())) {
+        return;
+    }
+
+    for (int index = length - 1; index >= 0; index--) {
+        file->data[file->pos++] = static_cast<unsigned char>(value >> (index * 8));
+    }
