+
+static bool readBytes(int id, int length, unsigned int* valuePtr)
+{
+    SfallFile* file = fileOf(id);
+    if (file == nullptr || file->pos + length > static_cast<int>(file->data.size())) {
+        return false;
+    }
+
+    unsigned int value = 0;
+    for (int index = 0; index < length; index++) {
+        value = (value << 8) | file->data[file->pos++];
+    }
+    *valuePtr = value;
+    return true;
+}
