+// sfallfs.sav, as sfall writes it: the number of files, then each one's
+// length, name (128 bytes) and position, and its bytes; numbers low byte first.
+
+static bool writeUInt32(File* stream, unsigned int value)
+{
+    unsigned char bytes[4] = {
+        static_cast<unsigned char>(value),
+        static_cast<unsigned char>(value >> 8),
+        static_cast<unsigned char>(value >> 16),
+        static_cast<unsigned char>(value >> 24),
+    };
+    return fileWrite(bytes, 1, 4, stream) == 4;
+}
+
+static bool readUInt32(File* stream, unsigned int* valuePtr)
+{
+    unsigned char bytes[4];
+    if (fileRead(bytes, 1, 4, stream) != 4) {
         return false;
     }
+    *valuePtr = bytes[0] | (bytes[1] << 8) | (bytes[2] << 16) | (static_cast<unsigned int>(bytes[3]) << 24);
+    return true;
+}
