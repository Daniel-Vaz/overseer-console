+        snprintf(name, sizeof(name), "%s", file.name.c_str());
+
+        if (!writeUInt32(stream, static_cast<unsigned int>(file.data.size()))
+            || fileWrite(name, 1, sizeof(name), stream) != sizeof(name)
+            || !writeUInt32(stream, static_cast<unsigned int>(file.pos))) {
+            return false;
+        }
+
+        if (!file.data.empty() && fileWrite(file.data.data(), 1, file.data.size(), stream) != file.data.size()) {
