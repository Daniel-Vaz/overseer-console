+bool sfallFileSystemLoad(File* stream)
+{
+    unsigned int count;
+    if (!readUInt32(stream, &count)) {
+        // An empty file: nothing kept.
+        return true;
+    }
+
+    for (unsigned int index = 0; index < count; index++) {
+        unsigned int length;
+        char name[kSavedNameLength + 1] = { 0 };
+        unsigned int pos;
+        if (!readUInt32(stream, &length)
+            || length > kMaxFileSize
+            || fileRead(name, 1, kSavedNameLength, stream) != kSavedNameLength
+            || !readUInt32(stream, &pos)) {
+            debugPrint("sfallfs.sav: file %u is damaged\n", index);
+            return false;
+        }
+
+        std::vector<unsigned char> data(length);
+        if (length != 0 && fileRead(data.data(), 1, length, stream) != length) {
+            debugPrint("sfallfs.sav: file %u is damaged\n", index);
+            return false;
+        }
+
+        int id = addFile(name, std::move(data));
+        files[id].pos = pos <= length ? static_cast<int>(pos) : 0;
+        files[id].saved = true;
+    }
+
+    return true;
 }
 
