+// Opens a copy of `data` as a read-only stream.
+XFile* xfileOpenMemory(const void* data, size_t size)
+{
+    XFile* stream = (XFile*)malloc(sizeof(*stream));
+    if (stream == nullptr) {
+        return nullptr;
+    }
+
+    memset(stream, 0, sizeof(*stream));
+
+    XMemoryFile* memory = (XMemoryFile*)malloc(sizeof(*memory));
+    unsigned char* copy = (unsigned char*)malloc(size != 0 ? size : 1);
+    if (memory == nullptr || copy == nullptr) {
+        free(memory);
+        free(copy);
+        free(stream);
+        return nullptr;
+    }
+
+    if (size != 0) {
+        memcpy(copy, data, size);
+    }
+
+    memory->data = copy;
+    memory->size = static_cast<long>(size);
+    memory->pos = 0;
+
+    stream->type = XFILE_TYPE_MEMORY;
+    stream->memory = memory;
+    return stream;
+}
