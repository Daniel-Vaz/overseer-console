diff --git a/src/sfall_perks.cc b/src/sfall_perks.cc
new file mode 100644
index 0000000..45d3c10
--- /dev/null
+++ b/src/sfall_perks.cc
@@ -0,0 +1,271 @@
+#include "sfall_perks.h"
+
+#include <stdint.h>
+#include <string.h>
+
+#include <algorithm>
+#include <string>
+
+#include "object.h"
+
+namespace fallout {
+
+// The size of each entry in sfallgv.sav, as sfall writes it: level, image,
+// name (64), description (512), 506 bytes unused, owner, and the id of an
+// extra perk it stands for (2), which nothing here uses.
+static constexpr int kSavedEntrySize = 4 + 4 + 64 + 512 + 506 + 4 + 2;
+
+static std::vector<SfallFakePerk> gFakePerks[SFALL_FAKE_PERK_LIST_COUNT];
+static std::vector<SfallFakePerk> gFakePerksBackup[SFALL_FAKE_PERK_LIST_COUNT];
+static std::string gPerkboxTitle;
+static bool gRealPerksHidden = false;
+static int gPerkAddMode = SFALL_PERK_ADD_AS_PERK;
+static int gPerkLevelMod = 0;
+
+static bool ownedByPlayer(const SfallFakePerk& perk)
+{
+    return perk.ownerId == 0 || (gDude != nullptr && perk.ownerId == gDude->id);
+}
+
+static void copyText(char* dest, size_t size, const char* text)
+{
+    strncpy(dest, text != nullptr ? text : "", size - 1);
+    dest[size - 1] = '\0';
+}
+
+void sfallPerksReset()
+{
+    for (auto& list : gFakePerks) {
+        list.clear();
+    }
+    gPerkboxTitle.clear();
+    gRealPerksHidden = false;
+    gPerkAddMode = SFALL_PERK_ADD_AS_PERK;
+    gPerkLevelMod = 0;
+}
+
+bool sfallPerksSave(File* stream)
+{
+    for (const auto& list : gFakePerks) {
+        int32_t count = static_cast<int32_t>(list.size());
+        if (fileWrite(&count, sizeof(count), 1, stream) != 1) {
+            return false;
+        }
+
+        for (const SfallFakePerk& perk : list) {
+            unsigned char entry[kSavedEntrySize] = { 0 };
+            int32_t level = perk.level;
+            int32_t image = perk.image;
+            int32_t ownerId = perk.ownerId;
+            int16_t id = -1;
+            memcpy(entry, &level, 4);
+            memcpy(entry + 4, &image, 4);
+            memcpy(entry + 8, perk.name, sizeof(perk.name));
+            memcpy(entry + 72, perk.description, sizeof(perk.description));
+            memcpy(entry + 1090, &ownerId, 4);
+            memcpy(entry + 1094, &id, 2);
+            if (fileWrite(entry, sizeof(entry), 1, stream) != 1) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+bool sfallPerksLoad(File* stream)
+{
+    sfallPerksReset();
+
+    for (auto& list : gFakePerks) {
+        int32_t count;
+        if (fileRead(&count, sizeof(count), 1, stream) != 1 || count < 0 || count > 10000) {
+            return false;
+        }
+
+        for (int32_t index = 0; index < count; index++) {
+            unsigned char entry[kSavedEntrySize];
+            if (fileRead(entry, sizeof(entry), 1, stream) != 1) {
+                return false;
+            }
+
+            SfallFakePerk perk;
+            int32_t value;
+            memcpy(&value, entry, 4);
+            perk.level = value;
+            memcpy(&value, entry + 4, 4);
+            perk.image = value;
+            memcpy(perk.name, entry + 8, sizeof(perk.name));
+            perk.name[sizeof(perk.name) - 1] = '\0';
+            memcpy(perk.description, entry + 72, sizeof(perk.description));
+            perk.description[sizeof(perk.description) - 1] = '\0';
+            memcpy(&value, entry + 1090, 4);
+            perk.ownerId = value;
+            list.push_back(perk);
+        }
+    }
+    return true;
+}
+
+void sfallSetFakePerk(SfallFakePerkList list, const char* name, int level, int image, const char* description, int ownerId)
+{
+    if (name == nullptr || level < 0) {
+        return;
+    }
+
+    // Traits and selectable perks are had or not; perks have up to 100 levels.
+    level = std::min(level, list == SFALL_FAKE_PERKS ? 100 : 1);
+
+    auto& perks = gFakePerks[list];
+    auto it = std::find_if(perks.begin(), perks.end(), [&](const SfallFakePerk& perk) {
+        return perk.ownerId == ownerId && strcmp(perk.name, name) == 0;
+    });
+
+    if (level == 0) {
+        if (it != perks.end()) {
+            perks.erase(it);
+        }
+        return;
+    }
+
+    if (it == perks.end()) {
+        SfallFakePerk perk;
+        copyText(perk.name, sizeof(perk.name), name);
+        perk.ownerId = ownerId;
+        perks.push_back(perk);
+        it = perks.end() - 1;
+    }
+
+    it->level = level;
+    it->image = image;
+    copyText(it->description, sizeof(it->description), description);
+}
+
+void sfallPerksBackup()
+{
+    for (int list = 0; list < SFALL_FAKE_PERK_LIST_COUNT; list++) {
+        gFakePerksBackup[list] = gFakePerks[list];
+    }
+}
+
+void sfallPerksRestore()
+{
+    for (int list = 0; list < SFALL_FAKE_PERK_LIST_COUNT; list++) {
+        gFakePerks[list] = gFakePerksBackup[list];
+    }
+}
+
+int sfallHasFakePerk(SfallFakePerkList list, const char* name)
+{
+    if (name == nullptr || name[0] == '\0') {
+        return 0;
+    }
+
+    for (const SfallFakePerk& perk : gFakePerks[list]) {
+        if (ownedByPlayer(perk) && strcmp(perk.name, name) == 0) {
+            return perk.level;
+        }
+    }
+    return 0;
+}
+
+int sfallHasFakePerkOwner(SfallFakePerkList list, const char* name, int ownerId)
+{
+    if (name == nullptr || name[0] == '\0') {
+        return 0;
+    }
+
+    for (const SfallFakePerk& perk : gFakePerks[list]) {
+        if (perk.ownerId == ownerId && strcmp(perk.name, name) == 0) {
+            return perk.level;
+        }
+    }
+    return 0;
+}
+
+std::vector<const SfallFakePerk*> sfallFakePerksOfPlayer(SfallFakePerkList list)
+{
+    std::vector<const SfallFakePerk*> owned;
+    for (const SfallFakePerk& perk : gFakePerks[list]) {
+        if (ownedByPlayer(perk)) {
+            owned.push_back(&perk);
+        }
+    }
+    return owned;
+}
+
+// Restores the perk box as it is without scripts.
+void sfallClearSelectablePerks()
+{
+    gFakePerks[SFALL_SELECTABLE_PERKS].clear();
+    gPerkboxTitle.clear();
+    gRealPerksHidden = false;
+    gPerkAddMode = SFALL_PERK_ADD_AS_PERK;
+}
+
+void sfallSetPerkboxTitle(const char* title)
+{
+    gPerkboxTitle = title != nullptr ? title : "";
+    if (gPerkboxTitle.size() > 32) {
+        gPerkboxTitle.resize(32);
+    }
+}
+
+const char* sfallPerkboxTitle()
+{
+    return gPerkboxTitle.empty() ? nullptr : gPerkboxTitle.c_str();
+}
+
+void sfallSetRealPerksHidden(bool hidden)
+{
+    gRealPerksHidden = hidden;
+}
+
+bool sfallRealPerksHidden()
+{
+    return gRealPerksHidden;
+}
+
+void sfallSetPerkAddMode(int mode)
+{
+    gPerkAddMode = mode;
+}
+
+void sfallTakeSelectablePerk(const char* name)
+{
+    auto& selectable = gFakePerks[SFALL_SELECTABLE_PERKS];
+    auto it = std::find_if(selectable.begin(), selectable.end(), [&](const SfallFakePerk& perk) {
+        return ownedByPlayer(perk) && strcmp(perk.name, name) == 0;
+    });
+    if (it == selectable.end()) {
+        return;
+    }
+
+    SfallFakePerk chosen = *it;
+
+    if ((gPerkAddMode & SFALL_PERK_ADD_AS_TRAIT) != 0) {
+        sfallSetFakePerk(SFALL_FAKE_TRAITS, chosen.name, 1, chosen.image, chosen.description, chosen.ownerId);
+    }
+
+    if ((gPerkAddMode & SFALL_PERK_ADD_AS_PERK) != 0) {
+        int level = sfallHasFakePerkOwner(SFALL_FAKE_PERKS, chosen.name, chosen.ownerId);
+        sfallSetFakePerk(SFALL_FAKE_PERKS, chosen.name, level + 1, chosen.image, chosen.description, chosen.ownerId);
+    }
+
+    if ((gPerkAddMode & SFALL_PERK_ADD_REMOVE_SELECTABLE) != 0) {
+        sfallSetFakePerk(SFALL_SELECTABLE_PERKS, chosen.name, 0, 0, nullptr, chosen.ownerId);
+    }
+}
+
+void sfallSetPerkLevelMod(int levels)
+{
+    if (levels >= -25 && levels <= 25) {
+        gPerkLevelMod = levels;
+    }
+}
+
+int sfallPerkLevelMod()
+{
+    return gPerkLevelMod;
+}
+
+} // namespace fallout
diff --git a/src/sfall_perks.h b/src/sfall_perks.h
new file mode 100644
index 0000000..6f8c864
--- /dev/null
+++ b/src/sfall_perks.h
@@ -0,0 +1,70 @@
+#ifndef FALLOUT_SFALL_PERKS_H_
+#define FALLOUT_SFALL_PERKS_H_
+
+#include <vector>
+
+#include "db.h"
+#include "obj_types.h"
+
+namespace fallout {
+
+// Traits and perks that scripts make up (sfall's set_fake_trait,
+// set_fake_perk and set_selectable_perk): shown on the character screen,
+// offered in the perk box, and kept with the game in sfallgv.sav.
+
+enum SfallFakePerkList {
+    SFALL_FAKE_TRAITS,
+    SFALL_FAKE_PERKS,
+    SFALL_SELECTABLE_PERKS,
+    SFALL_FAKE_PERK_LIST_COUNT,
+};
+
+// What perk_add_mode says a perk chosen from the selectable ones becomes.
+#define SFALL_PERK_ADD_AS_TRAIT 0x1
+#define SFALL_PERK_ADD_AS_PERK 0x2
+#define SFALL_PERK_ADD_REMOVE_SELECTABLE 0x4
+
+struct SfallFakePerk {
+    int level;
+    int image;
+    char name[64];
+    char description[512];
+    // The party member it belongs to, by object id; 0 for the player.
+    int ownerId;
+};
+
+void sfallPerksReset();
+bool sfallPerksSave(File* stream);
+bool sfallPerksLoad(File* stream);
+
+// A level of 0 takes it away. Traits and selectable perks have no levels: 1 or 0.
+void sfallSetFakePerk(SfallFakePerkList list, const char* name, int level, int image, const char* description, int ownerId);
+
+// The level the player has of it, or 0.
+int sfallHasFakePerk(SfallFakePerkList list, const char* name);
+int sfallHasFakePerkOwner(SfallFakePerkList list, const char* name, int ownerId);
+
+// Kept when the character screen opens, and put back when it is cancelled.
+void sfallPerksBackup();
+void sfallPerksRestore();
+
+// The player's, in the order they were given.
+std::vector<const SfallFakePerk*> sfallFakePerksOfPlayer(SfallFakePerkList list);
+
+// The perk box.
+void sfallClearSelectablePerks();
+void sfallSetPerkboxTitle(const char* title);
+const char* sfallPerkboxTitle();
+void sfallSetRealPerksHidden(bool hidden);
+bool sfallRealPerksHidden();
+void sfallSetPerkAddMode(int mode);
+// Gives the player the selectable perk of that name as perk_add_mode says.
+void sfallTakeSelectablePerk(const char* name);
+
+// Levels added to the player's own when deciding which perks can be chosen.
+void sfallSetPerkLevelMod(int levels);
+int sfallPerkLevelMod();
+
+} // namespace fallout
+
+#endif /* FALLOUT_SFALL_PERKS_H_ */
diff --git a/src/sfall_stat_mods.cc b/src/sfall_stat_mods.cc
new file mode 100644
index 0000000..224c592
--- /dev/null
+++ b/src/sfall_stat_mods.cc
@@ -0,0 +1,91 @@
+#include "sfall_stat_mods.h"
+
+#include <algorithm>
+#include <vector>
+
+#include "object.h"
+
+namespace fallout {
+
+namespace {
+
+struct HitChanceMod {
+    int objectId;
+    int maximum;
+    int mod;
+};
+
+constexpr int kDefaultHitChanceMaximum = 95;
+constexpr int kDefaultHpPerLevel = 2;
+
+} // namespace
+
+static int gXpModPercent = 100;
+static int gHpPerLevel = kDefaultHpPerLevel;
+static HitChanceMod gBaseHitChanceMod = { -1, kDefaultHitChanceMaximum, 0 };
+static std::vector<HitChanceMod> gCritterHitChanceMods;
+
+void sfallStatModsReset()
+{
+    gXpModPercent = 100;
+    gHpPerLevel = kDefaultHpPerLevel;
+    gBaseHitChanceMod = { -1, kDefaultHitChanceMaximum, 0 };
+    gCritterHitChanceMods.clear();
+}
+
+void sfallSetXpMod(int percent)
+{
+    gXpModPercent = percent & 0xFFFF;
+}
+
+int sfallApplyXpMod(int xp)
+{
+    if (gXpModPercent == 100) {
+        return xp;
+    }
+    return static_cast<int>(static_cast<long long>(xp) * gXpModPercent / 100);
+}
+
+void sfallSetHpPerLevelMod(int hitPoints)
+{
+    gHpPerLevel = std::clamp(hitPoints, -127, 127);
+}
+
+int sfallHpPerLevel()
+{
+    return gHpPerLevel;
+}
+
+void sfallSetHitChanceMod(Object* critter, int maximum, int mod)
+{
+    if (critter == nullptr) {
+        gBaseHitChanceMod.maximum = maximum;
+        gBaseHitChanceMod.mod = mod;
+        return;
+    }
+
+    for (HitChanceMod& entry : gCritterHitChanceMods) {
+        if (entry.objectId == critter->id) {
+            entry.maximum = maximum;
+            entry.mod = mod;
+            return;
+        }
+    }
+    gCritterHitChanceMods.push_back({ critter->id, maximum, mod });
+}
+
+int sfallApplyHitChanceMod(Object* attacker, int toHit)
+{
+    const HitChanceMod* entry = &gBaseHitChanceMod;
+    if (attacker != nullptr) {
+        for (const HitChanceMod& critterEntry : gCritterHitChanceMods) {
+            if (critterEntry.objectId == attacker->id) {
+                entry = &critterEntry;
+                break;
+            }
+        }
+    }
+    return std::min(toHit + entry->mod, entry->maximum);
+}
+
+} // namespace fallout
