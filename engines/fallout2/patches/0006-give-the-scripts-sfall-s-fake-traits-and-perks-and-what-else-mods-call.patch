+#ifndef FALLOUT_SFALL_STAT_MODS_H_
+#define FALLOUT_SFALL_STAT_MODS_H_
+
+#include "obj_types.h"
+
+namespace fallout {
+
+// What sfall's set_xp_mod, set_hp_per_level_mod and the hit chance mods
+// change of the game's rules, until the game is reset.
+
+void sfallStatModsReset();
+
+// Experience gained, by percent.
+void sfallSetXpMod(int percent);
+int sfallApplyXpMod(int xp);
+
+// Hit points gained with each level besides half of Endurance: 2 in the game.
+void sfallSetHpPerLevelMod(int hitPoints);
+int sfallHpPerLevel();
+
+// The chance to hit of an attacker: raised or lowered, and capped (95 in the game).
+// A critter of null sets them for every critter that has none of its own.
+void sfallSetHitChanceMod(Object* critter, int maximum, int mod);
+int sfallApplyHitChanceMod(Object* attacker, int toHit);
+
+} // namespace fallout
+
+#endif /* FALLOUT_SFALL_STAT_MODS_H_ */
