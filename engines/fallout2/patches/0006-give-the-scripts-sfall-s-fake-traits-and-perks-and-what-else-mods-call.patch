+static void warnMemoryAccess(Program* program, const char* what, int address)
+{
+    static std::vector<std::string> warned;
+    std::string key = std::string(program->name) + ":" + what;
+    if (std::find(warned.begin(), warned.end(), key) == warned.end()) {
+        warned.push_back(key);
+        debugPrint("%s: '%s' at 0x%x does nothing on this engine\n", program->name, what, address);
+    }
