+template <int size>
+static void op_read_memory(Program* program)
+{
+    int address = programStackPopInteger(program);
+    warnMemoryAccess(program, size == 2 ? "read_short" : "read_int", address);
+    programStackPushInteger(program, 0);
+}
+
+static void op_read_string(Program* program)
+{
+    int address = programStackPopInteger(program);
+    warnMemoryAccess(program, "read_string", address);
+    programStackPushString(program, "");
+}
+
+static void op_write_memory(Program* program)
+{
+    programStackPopValue(program);
+    int address = programStackPopInteger(program);
+    warnMemoryAccess(program, "write_byte/short/int/string", address);
+}
