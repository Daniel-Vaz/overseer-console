+// call_offset_v0 .. v4 (0x81d2 to 0x81d6) and call_offset_r0 .. r4 (0x81d7 to
+// 0x81db): an address and up to four arguments; the second five return a value.
+static void op_call_offset(Program* program)
+{
+    int index = ((program->flags >> 16) & 0x3FF) - 0x1D2;
+    for (int arg = 0; arg < index % 5; arg++) {
+        programStackPopValue(program);
+    }
+    int address = programStackPopInteger(program);
+    warnMemoryAccess(program, "call_offset", address);
+    if (index >= 5) {
+        programStackPushInteger(program, 0);
+    }
 }
 
