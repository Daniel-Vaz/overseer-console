+// SFALL: the party member of that proto id, or of that name where the id is 0.
+Object* partyMemberFind(int pid, const char* name)
+{
+    for (int i = 1; i < gPartyMembersLength; i++) {
+        Object* obj = gPartyMembers[i].object;
+        if (ProtoId(obj).objectType() != OBJ_TYPE_CRITTER) {
+            continue;
+        }
+
+        if (pid != 0 ? ProtoId(obj).pid() == pid : (name != nullptr && compat_stricmp(critterGetName(obj), name) == 0)) {
+            return obj;
+        }
+    }
+    return nullptr;
+}
+
+// SFALL: what partyMemberIncLevels keeps of a party member's levels.
+static PartyMemberLevelUpInfo* partyMemberLevelUpInfoOf(Object* obj)
+{
+    for (int index = 1; index < gPartyMemberDescriptionsLength; index++) {
+        if (gPartyMemberProtoIds[index] == ProtoId(obj)) {
+            return &(_partyMemberLevelUpInfoList[index]);
+        }
+    }
+    return nullptr;
+}
+
+// SFALL: get_npc_level. The levels a party member has gained, or -1.
+int partyMemberGetLevel(Object* obj)
+{
+    PartyMemberLevelUpInfo* levelUpInfo = obj != nullptr ? partyMemberLevelUpInfoOf(obj) : nullptr;
+    return levelUpInfo != nullptr ? levelUpInfo->level : -1;
+}
+
+// SFALL: inc_npc_level. A level for a party member that can gain one, whatever
+// the player's level and however long since its last.
+int partyMemberIncLevel(Object* obj)
+{
+    PartyMemberDescription* memberDescription;
+    if (obj == nullptr || partyMemberGetDescription(obj, &memberDescription) == -1 || memberDescription->level_up_every == 0) {
+        return -1;
+    }
+
+    PartyMemberLevelUpInfo* levelUpInfo = partyMemberLevelUpInfoOf(obj);
+    if (levelUpInfo == nullptr || levelUpInfo->level >= memberDescription->level_pids_num) {
+        return -1;
+    }
+
+    levelUpInfo->numLevelUps++;
+
+    if (_partyMemberCopyLevelInfo(obj, ProtoId(memberDescription->level_pids[levelUpInfo->level])) == -1) {
+        return -1;
+    }
+
+    levelUpInfo->level++;
+    levelUpInfo->isEarly = 0;
+
+    // %s has gained in some abilities.
+    MessageListItem msg;
+    char str[260];
+    snprintf(str, sizeof(str), getmsg(&gMiscMessageList, &msg, 9000), critterGetName(obj));
+    displayMonitorAddMessage(str);
+    return 0;
+}
+
 bool partyMemberEngineLevelUpEnabled()
 {
     return npcEngineLevelUp;
