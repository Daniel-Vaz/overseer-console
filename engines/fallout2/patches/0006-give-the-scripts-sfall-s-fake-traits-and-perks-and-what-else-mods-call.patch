+// The owner of a party member's made-up traits and perks: 0 for the player (see sfall_perks.h), or -1 when it
+// is not in the party.
+static int fakePerkOwner(OpcodeContext& ctx)
+{
+    Object* obj = ctx.arg(0).asObject();
+    if (obj == nullptr || ProtoId(obj).objectType() != OBJ_TYPE_CRITTER || !objectIsPartyMember(obj)) {
+        ctx.printError("%s() - the object is not a party member.", ctx.name());
+        return -1;
+    }
+    return obj == gDude ? 0 : obj->id;
+}
+
+static void setFakePerkNpc(OpcodeContext& ctx, SfallFakePerkList list)
+{
+    int owner = fakePerkOwner(ctx);
+    if (owner == -1) {
+        ctx.setReturn(-1);
+        return;
+    }
+    sfallSetFakePerk(list, ctx.stringArg(1), ctx.arg(2).asInt(), ctx.arg(3).asInt(), ctx.stringArg(4), owner);
+}
+
+void mf_has_fake_perk_npc(OpcodeContext& ctx)
+{
+    int owner = fakePerkOwner(ctx);
+    ctx.setReturn(owner == -1 ? 0 : sfallHasFakePerkOwner(SFALL_FAKE_PERKS, ctx.stringArg(1), owner));
+}
+
+void mf_has_fake_trait_npc(OpcodeContext& ctx)
+{
+    int owner = fakePerkOwner(ctx);
+    ctx.setReturn(owner == -1 ? 0 : sfallHasFakePerkOwner(SFALL_FAKE_TRAITS, ctx.stringArg(1), owner));
+}
+
+void mf_set_fake_perk_npc(OpcodeContext& ctx)
+{
+    setFakePerkNpc(ctx, SFALL_FAKE_PERKS);
+}
+
+void mf_set_fake_trait_npc(OpcodeContext& ctx)
+{
+    setFakePerkNpc(ctx, SFALL_FAKE_TRAITS);
+}
+
+void mf_set_selectable_perk_npc(OpcodeContext& ctx)
