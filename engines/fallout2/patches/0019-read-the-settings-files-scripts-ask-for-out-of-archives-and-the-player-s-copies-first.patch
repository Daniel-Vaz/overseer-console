+// The player's own copies of settings files, put here by the page under the
+// path each has in the game folder, are read in place of the game's.
+static constexpr const char* kPlayerCopiesFolder = "overseer\\settings";
+
+static void sfall_player_copy_path(const char* path, char* copy, size_t size)
+{
+    snprintf(copy, size, "%s\\%s", kPlayerCopiesFolder, sfall_strip_ini_path_prefix(path));
+}
+
+// Reads the file at `path`: the player's copy of it, else the file itself,
+// else out of the archive a mod's folder on its path was packed into.
+static bool sfall_read_ini_at(const char* path, Config* config)
+{
+    char copy[COMPAT_MAX_PATH];
+    sfall_player_copy_path(path, copy, sizeof(copy));
+    return configRead(config, copy, false) || configRead(config, path, false) || configReadArchived(config, path);
+}
+
+// Reads the file at `path` (COMPAT_MAX_PATH long) to change it, and points
+// `path` at where the change goes: the player's copy where there is one, or
+// where the file is in an archive, which is not written to.
+static bool sfall_read_ini_for_change(char* path, Config* config)
+{
+    char copy[COMPAT_MAX_PATH];
+    sfall_player_copy_path(path, copy, sizeof(copy));
+    if (configRead(config, copy, false)) {
+        snprintf(path, COMPAT_MAX_PATH, "%s", copy);
+        return true;
+    }
+
+    if (configRead(config, path, false)) {
+        return true;
+    }
+
+    if (configReadArchived(config, path)) {
+        snprintf(path, COMPAT_MAX_PATH, "%s", copy);
+        char* sep = strrchr(copy, '\\');
+        if (sep != nullptr) {
+            *sep = '\0';
+            compat_mkdir_recursive(copy);
+        }
+        return true;
+    }
+
+    return false;
+}
