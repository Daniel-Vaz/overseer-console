+// A settings file inside an archive: the part of the path up to a .dat that is
+// a file, and not a folder, is opened as one, and the rest is read out of it.
+bool configReadArchived(Config* config, const char* filePath)
+{
+    if (config == nullptr || filePath == nullptr) {
+        return false;
+    }
+
+    char path[COMPAT_MAX_PATH];
+    snprintf(path, sizeof(path), "%s", filePath);
+    for (char* pch = path; *pch != '\0'; pch++) {
+        if (*pch == '/') {
+            *pch = '\\';
+        }
+    }
+
+    for (char* sep = strchr(path, '\\'); sep != nullptr; sep = strchr(sep + 1, '\\')) {
+        size_t length = sep - path;
+        if (length < 4 || compat_strnicmp(sep - 4, ".dat", 4) != 0) {
+            continue;
+        }
+
+        *sep = '\0';
+        bool archive = compat_file_exists(path) && !compat_is_dir(path);
+        DBase* dbase = archive ? dbaseOpen(path) : nullptr;
+        *sep = '\\';
+        if (dbase == nullptr) {
+            continue;
+        }
+
+        DFile* stream = dfileOpen(dbase, sep + 1, "rt");
+        if (stream == nullptr) {
+            dbaseClose(dbase);
+            continue;
+        }
+
+        char string[CONFIG_FILE_MAX_LINE_LENGTH];
+        while (dfileReadString(string, sizeof(string), stream) != nullptr) {
+            configParseLine(config, string);
+        }
+        dfileClose(stream);
+        dbaseClose(dbase);
+        return true;
+    }
+
+    return false;
+}
