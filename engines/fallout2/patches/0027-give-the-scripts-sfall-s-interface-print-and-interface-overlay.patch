+// interface_print(text, winType, x, y, color, width): as the original's
+// PrintRect, onto an interface window, or onto its overlay where it has one.
+// The color's flags are the engine's: shadow, no background (switched, as
+// sfall does), no redraw.
+static void mf_interface_print(OpcodeContext& ctx)
+{
+    int win = -1;
+    if (getInterfaceWindowByType(ctx.arg(1).asInt(), win) != InterfaceWindowLookupResult::Found) {
+        ctx.printError("%s() - the game interface window is not created or invalid window type number.", ctx.name());
+        ctx.setReturn(-1);
+        return;
+    }
+
+    Window* window = windowGetWindow(win);
+    char* text = const_cast<char*>(ctx.stringArg(0));
+    int x = std::max(0, ctx.arg(2).asInt());
+    int y = std::max(0, ctx.arg(3).asInt());
+    unsigned int color = static_cast<unsigned int>(ctx.arg(4).asInt());
+    int width = ctx.numArgs() > 5 ? ctx.arg(5).asInt() : 0;
+
+    int maxHeight = window->height - y;
+    int maxWidth = window->width - x;
+    if (width <= 0 || width > maxWidth) {
+        width = maxWidth;
+    }
+
+    color ^= DRAW_TEXT_FLAG_NO_BG;
+    if ((color & 0xFF) == 0) {
+        color |= scriptWindowGetTextColor();
+    }
+
+    // Drawn on the overlay where there is one: the engine draws where a window's buffer is.
+    unsigned char* buffer = window->buffer;
+    if (window->overlay != nullptr) {
+        window->buffer = window->overlay;
+    }
+
+    if ((color & DRAW_TEXT_FLAG_SHADOWED) != 0) {
+        windowWrapLineWithSpacing(win, text, width, maxHeight, x, y, static_cast<ColorWithFlags>(0x201000F), TEXT_ALIGNMENT_LEFT, 0);
+        color ^= DRAW_TEXT_FLAG_SHADOWED;
+    }
+    windowWrapLineWithSpacing(win, text, width, maxHeight, x, y, static_cast<ColorWithFlags>(color), TEXT_ALIGNMENT_LEFT, 0);
+
+    window->buffer = buffer;
+
+    if ((color & DRAW_TEXT_FLAG_REFRESH) == 0) {
+        windowRefresh(win);
+    }
+}
+
+// interface_overlay(winType, mode, x, y, w, h): 0 takes the window's
+// overlay away, 1 makes one, 2 clears it (or the rectangle given).
+static void mf_interface_overlay(OpcodeContext& ctx)
+{
+    int win = -1;
+    if (getInterfaceWindowByType(ctx.arg(0).asInt(), win) != InterfaceWindowLookupResult::Found) {
+        return;
+    }
+
+    switch (ctx.arg(1).asInt()) {
+    case 0:
+        windowDestroyOverlay(win);
+        break;
+    case 1:
+        windowCreateOverlay(win);
+        break;
+    case 2:
+        if (ctx.numArgs() > 2) {
+            int x = ctx.arg(2).asInt();
+            int y = ctx.numArgs() > 3 ? ctx.arg(3).asInt() : 0;
+            int w = ctx.numArgs() > 4 ? ctx.arg(4).asInt() : 0;
+            int h = ctx.numArgs() > 5 ? ctx.arg(5).asInt() : 0;
+            if (w <= 0 || h <= 0 || x < 0 || y < 0) {
+                return;
+            }
+            Rect rect = { x, y, x + w - 1, y + h - 1 };
+            windowClearOverlay(win, &rect);
+        } else {
+            windowClearOverlay(win, nullptr);
+        }
+        break;
+    }
+}
