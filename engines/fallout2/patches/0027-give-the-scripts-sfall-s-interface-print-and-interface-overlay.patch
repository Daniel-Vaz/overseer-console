+// SFALL: interface_overlay. Makes an empty overlay for a window, where it
+// has none.
+bool windowCreateOverlay(int win)
+{
+    Window* window = windowGetWindow(win);
+    if (window == nullptr) {
+        return false;
+    }
+
+    if (window->overlay == nullptr) {
+        size_t size = static_cast<size_t>(window->width) * window->height;
+        window->overlay = (unsigned char*)internal_malloc(size);
+        if (window->overlay != nullptr) {
+            memset(window->overlay, 0, size);
+        }
+    }
+
+    return window->overlay != nullptr;
+}
+
+void windowDestroyOverlay(int win)
+{
+    Window* window = windowGetWindow(win);
+    if (window != nullptr && window->overlay != nullptr) {
+        internal_free(window->overlay);
+        window->overlay = nullptr;
+        windowRefresh(win);
+    }
+}
+
+// Clears a part of a window's overlay (all of it for null).
+void windowClearOverlay(int win, const Rect* rect)
+{
+    Window* window = windowGetWindow(win);
+    if (window == nullptr || window->overlay == nullptr) {
+        return;
+    }
+
+    int left = rect != nullptr ? std::max(rect->left, 0) : 0;
+    int top = rect != nullptr ? std::max(rect->top, 0) : 0;
+    int right = rect != nullptr ? std::min(rect->right, window->width - 1) : window->width - 1;
+    int bottom = rect != nullptr ? std::min(rect->bottom, window->height - 1) : window->height - 1;
+    for (int y = top; y <= bottom; y++) {
+        if (right >= left) {
+            memset(window->overlay + y * window->width + left, 0, right - left + 1);
+        }
+    }
+    windowRefresh(win);
+}
