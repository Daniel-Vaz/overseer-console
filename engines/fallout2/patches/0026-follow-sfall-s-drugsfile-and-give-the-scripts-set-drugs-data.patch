+// set_drugs_data(type, pid, value): for a drug in sfall's DrugsFile, 0 its NumEffects, 1 its AddictTime.
+void mf_set_drugs_data(OpcodeContext& ctx)
+{
+    int type = ctx.arg(0).asInt();
+    int pid = ctx.arg(1).asInt();
+    int value = ctx.arg(2).asInt();
+    int result;
+    if (type == 0) {
+        result = drugsSetNumEffects(pid, value);
+    } else if (type == 1) {
+        result = drugsSetAddictTime(pid, value);
+    } else {
+        ctx.printError("%s() - invalid type number.", ctx.name());
+        return;
+    }
+    if (result != 0) {
+        ctx.printError("%s() - drug PID not found in the configuration file.", ctx.name());
+        ctx.setReturn(-1);
+    }
+}
