+// SFALL: DrugsFile ([Misc] in ddraw.ini), sfall's Drugs module: for each
+// drug in it, how many of its effects may be waiting at once (NumEffects),
+// how long its withdrawal lasts (AddictTime, in game minutes), and for a drug
+// the engine does not know, the global variable that holds its addiction and
+// how the character screen shows it (GvarID, TextID, FrmID).
+
+typedef struct SfallDrug {
+    int pid;
+    // -1: the engine's own count, for a drug the engine knows.
+    int numEffects;
+    int iniNumEffects;
+    int addictTime;
+    int iniAddictTime;
+    int gvar;
+    int messageId;
+    int frmId;
+} SfallDrug;
+
+static constexpr int kSfallDrugsMax = 50;
+
+static std::vector<SfallDrug> gSfallDrugs;
+// A script changed something with set_drugs_data: put back on a new game.
+static bool gSfallDrugsChanged = false;
+
+static DrugDescription* engineDrug(int pid)
+{
+    for (int index = 0; index < ADDICTION_COUNT; index++) {
+        if (gDrugDescriptions[index].drugPid == pid) {
+            return &(gDrugDescriptions[index]);
+        }
+    }
+    return nullptr;
+}
+
+static SfallDrug* sfallDrug(int pid)
+{
+    for (auto& drug : gSfallDrugs) {
+        if (drug.pid == pid) {
+            return &drug;
+        }
+    }
+    return nullptr;
+}
+
+static void drugsInit()
+{
+    gSfallDrugs.clear();
+
+    char* path;
+    configGetString(&gSfallConfig, SFALL_CONFIG_MISC_KEY, "DrugsFile", &path);
+    if (path == nullptr || *path == '\0') {
+        return;
+    }
+
+    ScopedConfig config(path, false);
+    if (!config) {
+        return;
+    }
+
+    int count = 0;
+    configGetInt(config.get(), "main", "Count", &count);
+    count = std::min(count, kSfallDrugsMax);
+
+    char section[4];
+    for (int index = 1; index <= count; index++) {
+        snprintf(section, sizeof(section), "%d", index);
+
+        int pid = 0;
+        configGetInt(config.get(), section, "PID", &pid);
+        if (pid <= 0) {
+            continue;
+        }
+
+        SfallDrug drug = { pid, 0, 0, 0, 0, 0, -1, -1 };
+        configGetInt(config.get(), section, "AddictTime", &drug.addictTime);
+        drug.iniAddictTime = drug.addictTime;
+
+        int numEffects = -1;
+        configGetInt(config.get(), section, "NumEffects", &numEffects);
+        DrugDescription* known = engineDrug(pid);
+        if (known != nullptr) {
+            // The engine's own drug: its count changed in the engine, and
+            // its addiction its own.
+            if (numEffects < -1) {
+                numEffects = -1;
+            } else if (numEffects > -1) {
+                known->maxActiveEffects = numEffects;
+            }
+            drug.iniNumEffects = known->maxActiveEffects;
+            drug.numEffects = numEffects;
+        } else {
+            drug.numEffects = drug.iniNumEffects = std::max(0, numEffects);
+            configGetInt(config.get(), section, "GvarID", &drug.gvar);
+            drug.gvar = std::max(0, drug.gvar);
+            if (drug.gvar != 0) {
+                int messageId = -1;
+                configGetInt(config.get(), section, "TextID", &messageId);
+                drug.messageId = messageId > 0 ? messageId : -1;
+                configGetInt(config.get(), section, "FrmID", &drug.frmId);
+            }
+        }
+
+        gSfallDrugs.push_back(drug);
+    }
+}
+
+static void drugsReset()
+{
+    if (!gSfallDrugsChanged) {
+        return;
+    }
+    gSfallDrugsChanged = false;
+
+    for (auto& drug : gSfallDrugs) {
+        DrugDescription* known = engineDrug(drug.pid);
+        if (known != nullptr) {
+            known->maxActiveEffects = drug.iniNumEffects;
+        }
+        drug.numEffects = known != nullptr && drug.numEffects == -1 ? -1 : drug.iniNumEffects;
+        drug.addictTime = drug.iniAddictTime;
+    }
+}
+
+// 1 or 0 for a drug in the file, -1 to leave it to the engine.
+static int drugsEffectAllowed(Object* critter, const ProtoId& protoId)
+{
+    SfallDrug* drug = sfallDrug(protoId.pid());
+    if (drug == nullptr || drug->numEffects == -1) {
+        return -1;
+    }
+
+    if (drug->numEffects == 0) {
+        return 1;
+    }
+
+    int count = 0;
+    DrugEffectEvent* event = (DrugEffectEvent*)queueFindFirstEvent(critter, EVENT_TYPE_DRUG);
+    while (event != nullptr) {
+        if (ProtoId(event->drugPid) == protoId && ++count >= drug->numEffects) {
+            return 0;
+        }
+        event = (DrugEffectEvent*)queueFindNextEvent(critter, EVENT_TYPE_DRUG);
+    }
+
+    return 1;
+}
+
+static int drugsAddictionGvar(const ProtoId& protoId)
+{
+    SfallDrug* drug = sfallDrug(protoId.pid());
+    return drug != nullptr && drug->gvar < gGameGlobalVarsLength ? drug->gvar : -1;
+}
+
+static int drugsAddictTime(const ProtoId& protoId)
+{
+    SfallDrug* drug = sfallDrug(protoId.pid());
+    return drug != nullptr && drug->addictTime > 0 ? drug->addictTime : 10080;
+}
+
+int drugsSetNumEffects(int pid, int numEffects)
+{
+    SfallDrug* drug = sfallDrug(pid);
+    if (drug == nullptr) {
+        return -1;
+    }
+
+    numEffects = std::max(0, numEffects);
+    DrugDescription* known = engineDrug(pid);
+    if (known != nullptr) {
+        known->maxActiveEffects = numEffects;
+    }
+    drug->numEffects = numEffects;
+    gSfallDrugsChanged = true;
+    return 0;
+}
+
+int drugsSetAddictTime(int pid, int minutes)
+{
+    SfallDrug* drug = sfallDrug(pid);
+    if (drug == nullptr) {
+        return -1;
+    }
+
+    drug->addictTime = std::max(0, minutes);
+    gSfallDrugsChanged = true;
+    return 0;
+}
+
+int drugsCount()
+{
+    return static_cast<int>(gSfallDrugs.size());
+}
+
+bool drugsAddictionAt(int index, int* gvarPtr, int* messageIdPtr, int* frmIdPtr)
+{
+    if (index < 0 || index >= static_cast<int>(gSfallDrugs.size())) {
+        return false;
+    }
+
+    const SfallDrug& drug = gSfallDrugs[index];
+    if (drug.gvar <= 0 || drug.gvar >= gGameGlobalVarsLength) {
+        return false;
+    }
+
+    // An addiction the engine shows itself.
+    for (int known = 0; known < ADDICTION_COUNT; known++) {
+        if (gDrugDescriptions[known].gvar == drug.gvar) {
+            return false;
+        }
+    }
+
+    *gvarPtr = drug.gvar;
+    *messageIdPtr = drug.messageId;
+    *frmIdPtr = drug.frmId;
+    return true;
+}
+
 } // namespace fallout
