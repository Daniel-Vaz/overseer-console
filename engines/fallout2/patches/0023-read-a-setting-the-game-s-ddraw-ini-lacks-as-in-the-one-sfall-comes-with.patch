@@ -310,6 +311,23 @@ static bool sfall_ini_get_string_internal(const char* triplet, char* value, size
             if (found != nullptr) {
                 *found = true;
             }
+            return true;
+        }
+    }
+
+    // Where sfall is installed, its ddraw.ini holds every setting, and mods
+    // read them: FO2tweaks takes a DamageFormula of -1 for one a player set,
+    // puts it back to 0 and asks for the game to be started again. A setting
+    // the game's ddraw.ini (if any) lacks reads as in the one sfall comes with.
+    if (compat_stricmp(sfall_strip_ini_path_prefix(fileName), "ddraw.ini") == 0) {
+        for (auto& setting : kSfallDdrawDefaults) {
+            if (compat_stricmp(section, setting.section) == 0 && compat_stricmp(key, setting.key) == 0) {
+                snprintf(value, size, "%s", setting.value);
+                if (found != nullptr) {
+                    *found = true;
+                }
+                break;
+            }
         }
     }
 
