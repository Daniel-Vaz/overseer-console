+// The page asks for a save now and then (see engines/lib/overseer.js). It is
+// made here, between two turns of the main loop, and only at a moment the
+// player could have made a quick save: outside combat and conversations,
+// while the game takes orders, with the player alive.
+static void mainAutosave()
+{
+#if defined(__EMSCRIPTEN__)
+    GameState state = gameGetState();
+    if (_game_user_wants_to_quit != GAME_QUIT_REQUEST_NONE
+        || (state != GameState::Normal && state != GameState::DialogFinished)
+        || gameUiIsDisabled()
+        || isInCombat()
+        || (gDude->data.critter.combat.results & (DAM_DEAD | DAM_KNOCKED_OUT)) != 0) {
+        return;
+    }
+
+    int slot = overseer_autosave_point();
+    if (slot > 0) {
+        overseer_autosaved(slot, lsgAutoSaveInSlot(slot - 1) == 0 ? 1 : 0);
+    }
+#endif
+}
