     return saveLoadTotalSlots;
 }
 
+// Saves into the given slot (zero-based) without asking, the way a quick save
+// does once its slot is known, described as an autosave with the time it was
+// made. Unlike a quick save it leaves the slot the player last picked alone,
+// and shows nothing when it fails: whoever asked for it says so.
+int lsgAutoSaveInSlot(int slot)
+{
+    if (slot < 0 || slot >= saveLoadTotalSlots) {
+        return -1;
+    }
+
+    ScopedGameMode gm(GameMode::kSaveGame);
+
+    _ls_error_code = 0;
+    _patches = settings.system.master_patches_path.c_str();
+
+    int playerSlot = _slot_cursor;
+    MouseCursorType cursor = gameMouseGetCursor();
+    _slot_cursor = slot;
+
+    snprintf(_gmpath, sizeof(_gmpath), "%s\\%s%.2d\\%s", "SAVEGAME", "SLOT", _slot_cursor + 1, "SAVE.DAT");
+    _flptr = fileOpen(_gmpath, "rb");
+    if (_flptr != nullptr) {
+        lsgLoadHeaderInSlot(_slot_cursor);
+        fileClose(_flptr);
+    }
+
+    time_t now = time(nullptr);
+    struct tm* local = localtime(&now);
+    snprintf(_LSData[slot].description, LOAD_SAVE_DESCRIPTION_LENGTH, "AUTOSAVE %02d:%02d", local->tm_hour, local->tm_min);
+
+    int rc = -1;
+    if (messageListInit(&gLoadSaveMessageList)) {
+        char path[COMPAT_MAX_PATH];
+        snprintf(path, sizeof(path), "%s%s", asc_5186C8, LSGAME_MSG_NAME);
+        if (messageListLoad(&gLoadSaveMessageList, path)) {
+            messageListRepositorySetStandardMessageList(STANDARD_MESSAGE_LIST_LSGAME, &gLoadSaveMessageList);
+
+            _snapshotBuf = nullptr;
+            if (_QuickSnapShot() == 1) {
+                rc = lsgPerformSaveGame();
+            }
+
+            if (_snapshotBuf != nullptr) {
+                internal_free(_snapshot);
+            }
+        }
+        loadSaveMessageListReset();
+    }
+
+    gameMouseSetCursor(cursor);
+    _slot_cursor = playerSlot;
+
+    return rc;
+}
