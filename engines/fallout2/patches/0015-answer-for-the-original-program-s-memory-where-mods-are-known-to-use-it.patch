diff --git a/src/sfall_memory.cc b/src/sfall_memory.cc
new file mode 100644
index 0000000..0f95bb0
--- /dev/null
+++ b/src/sfall_memory.cc
@@ -0,0 +1,217 @@
+#include "sfall_memory.h"
+
+#include <stdint.h>
+#include <string.h>
+
+#include <algorithm>
+#include <vector>
+
+#include "object.h"
+
+namespace fallout {
+
+namespace {
+
+struct Area {
+    unsigned int address;
+    // A variable laid out as the original's...
+    unsigned char* data;
+    int size;
+    // ...a pointer...
+    void** pointer;
+    // ...or an int kept otherwise.
+    int (*get)();
+    void (*set)(int);
+};
+
+struct Call {
+    unsigned int address;
+    ProgramValue (*function)(const ProgramValue* args, int argCount);
+};
+
+// Filled as the engine's files are set up, before anything runs.
+std::vector<Area>& areas()
+{
+    static std::vector<Area> list;
+    return list;
+}
+
+std::vector<Call>& calls()
+{
+    static std::vector<Call> list;
+    return list;
+}
+
+int areaSize(const Area& area)
+{
+    return area.data != nullptr ? area.size : 4;
+}
+
+const Area* areaAt(unsigned int address, int size)
+{
+    for (const Area& area : areas()) {
+        if (address >= area.address && address + size <= area.address + areaSize(area)) {
+            return &area;
+        }
+    }
+    return nullptr;
+}
+
+// The original's memory manager keeps this before each block it gives out:
+// scripts look for it before an object they kept to know it still is one.
+constexpr int kBlockCookie = static_cast<int>(0xFEEDFACE);
+
+ProgramValue pointerValue(void* pointer)
+{
+    ProgramValue value;
+    value.opcode = VALUE_TYPE_PTR;
+    value.pointerValue = pointer;
+    return value;
+}
+
+} // namespace
+
+SfallMemoryArea::SfallMemoryArea(unsigned int address, void* data, int size)
+{
+    areas().push_back({ address, static_cast<unsigned char*>(data), size, nullptr, nullptr, nullptr });
+}
+
+SfallMemoryArea::SfallMemoryArea(unsigned int address, void** pointer)
+{
+    areas().push_back({ address, nullptr, 0, pointer, nullptr, nullptr });
+}
+
+SfallMemoryArea::SfallMemoryArea(unsigned int address, int (*get)(), void (*set)(int))
+{
+    areas().push_back({ address, nullptr, 0, nullptr, get, set });
+}
+
+SfallMemoryCall::SfallMemoryCall(unsigned int address, ProgramValue (*function)(const ProgramValue* args, int argCount))
+{
+    calls().push_back({ address, function });
+}
+
+bool sfallMemoryIs(const unsigned char* bytes, std::initializer_list<unsigned char> patch)
+{
+    return std::equal(patch.begin(), patch.end(), bytes);
+}
+
+int sfallMemoryInt(const unsigned char* bytes)
+{
+    return static_cast<int>(bytes[0] | (bytes[1] << 8) | (bytes[2] << 16) | (static_cast<unsigned int>(bytes[3]) << 24));
+}
+
+bool sfallMemoryRead(unsigned int address, int size, ProgramValue* valuePtr)
+{
+    const Area* area = areaAt(address, size);
+    if (area == nullptr) {
+        // An object's block, asked after.
+        if (size == 4 && objectIsLive(reinterpret_cast<Object*>(static_cast<uintptr_t>(address + 4)))) {
+            *valuePtr = ProgramValue(kBlockCookie);
+            return true;
+        }
+        return false;
+    }
+
+    if (area->pointer != nullptr) {
+        *valuePtr = address == area->address && size == 4 ? pointerValue(*area->pointer) : ProgramValue(0);
+        return true;
+    }
+
+    if (area->get != nullptr) {
+        unsigned int value = static_cast<unsigned int>(area->get()) >> ((address - area->address) * 8);
+        *valuePtr = ProgramValue(static_cast<int>(size == 4 ? value : value & ((1u << (size * 8)) - 1)));
+        return true;
+    }
+
+    unsigned int value = 0;
+    memcpy(&value, area->data + (address - area->address), size);
+    // read_byte and read_short give what they read unsigned, as sfall does.
+    *valuePtr = ProgramValue(static_cast<int>(value));
+    return true;
+}
+
+bool sfallMemoryReadString(unsigned int address, std::string* string)
+{
+    const Area* area = areaAt(address, 1);
+    if (area == nullptr || area->data == nullptr) {
+        return false;
+    }
+
+    const char* start = reinterpret_cast<const char*>(area->data + (address - area->address));
+    size_t room = area->address + area->size - address;
+    string->assign(start, strnlen(start, room));
+    return true;
+}
+
+bool sfallMemoryWrite(unsigned int address, int size, const ProgramValue& value)
+{
+    const Area* area = areaAt(address, size);
+    if (area == nullptr) {
+        return false;
+    }
+
+    if (area->pointer != nullptr) {
+        if (address == area->address && size == 4) {
+            *area->pointer = sfallMemoryArgPointer(value);
+        }
+        return true;
+    }
+
+    unsigned int bits = static_cast<unsigned int>(sfallMemoryArgInt(value));
+
+    if (area->set != nullptr) {
+        int shift = (address - area->address) * 8;
+        unsigned int mask = size == 4 ? 0xFFFFFFFFu : ((1u << (size * 8)) - 1);
+        unsigned int old = static_cast<unsigned int>(area->get());
+        area->set(static_cast<int>((old & ~(mask << shift)) | ((bits & mask) << shift)));
+        return true;
+    }
+
+    memcpy(area->data + (address - area->address), &bits, size);
+    return true;
+}
+
+bool sfallMemoryWriteString(unsigned int address, const char* string)
+{
+    const Area* area = areaAt(address, 1);
+    if (area == nullptr || area->data == nullptr) {
+        return false;
+    }
+
+    // As far as the variable goes, ended as a string.
+    size_t room = area->address + area->size - address;
+    size_t length = std::min(strlen(string), room - 1);
+    memcpy(area->data + (address - area->address), string, length);
+    area->data[address - area->address + length] = '\0';
+    return true;
+}
+
+bool sfallMemoryCall(unsigned int address, const ProgramValue* args, int argCount, ProgramValue* resultPtr)
+{
+    for (const Call& call : calls()) {
+        if (call.address == address) {
+            *resultPtr = call.function(args, argCount);
+            return true;
+        }
+    }
+    return false;
+}
+
+int sfallMemoryArgInt(const ProgramValue& value)
+{
+    if (value.opcode == VALUE_TYPE_PTR) {
+        return static_cast<int>(reinterpret_cast<uintptr_t>(value.pointerValue));
+    }
+    return value.integerValue;
+}
+
+void* sfallMemoryArgPointer(const ProgramValue& value)
+{
+    if (value.opcode == VALUE_TYPE_PTR) {
+        return value.pointerValue;
+    }
+    return reinterpret_cast<void*>(static_cast<uintptr_t>(static_cast<unsigned int>(value.integerValue)));
+}
+
+} // namespace fallout
diff --git a/src/sfall_memory.h b/src/sfall_memory.h
new file mode 100644
index 0000000..f946b27
--- /dev/null
+++ b/src/sfall_memory.h
@@ -0,0 +1,79 @@
+#ifndef FALLOUT_SFALL_MEMORY_H_
+#define FALLOUT_SFALL_MEMORY_H_
+
+#include <initializer_list>
+#include <string>
+
+#include "interpreter.h"
+
+namespace fallout {
+
+// The original program's memory, as the scripts made for sfall reach into it:
+// read_byte .. read_string, write_byte .. write_string and call_offset_*,
+// with the addresses of Fallout 2 1.02 (US).
+//
+// Of it, what mods are known to use is registered beside what stands for it
+// here: a variable of the game's where it is laid out as the original's (an
+// int, an array of them, a struct of ints), a getter and setter where it is
+// not, and a function. Where a mod changes the original's code, the few bytes
+// it changes are kept here as the original has them, registered the same
+// way, and the engine does what they say where the original ran them (see
+// sfallMemoryIs). Anything else reads 0 and takes no change, as before.
+//
+// npm run sfall-scan lists what a mod uses that is not registered.
+
+class SfallMemoryArea {
+public:
+    // A variable laid out as the original's.
+    SfallMemoryArea(unsigned int address, void* data, int size);
+    // A pointer (an object, an inventory): scripts see it as one.
+    SfallMemoryArea(unsigned int address, void** pointer);
+    // An int the engine keeps otherwise.
+    SfallMemoryArea(unsigned int address, int (*get)(), void (*set)(int));
+};
+
+class SfallMemoryCall {
+public:
+    // A function of the original's, given what the script passes (as many as
+    // four values, those it did not pass 0) and returning what call_offset_r*
+    // gives back.
+    SfallMemoryCall(unsigned int address, ProgramValue (*function)(const ProgramValue* args, int argCount));
+};
+
+#define SFALL_MEMORY_CONCAT_(a, b) a##b
+#define SFALL_MEMORY_CONCAT(a, b) SFALL_MEMORY_CONCAT_(a, b)
+
+// `variable` at `address`, `size` bytes as the original has it.
+#define SFALL_MEMORY(address, variable, size)                                                       \
+    static_assert(sizeof(variable) == (size), #variable " is not laid out as the original's");     \
+    static SfallMemoryArea SFALL_MEMORY_CONCAT(gSfallMemoryArea, __LINE__)(address, (void*)&(variable), size)
+
+#define SFALL_MEMORY_POINTER(address, variable) \
+    static SfallMemoryArea SFALL_MEMORY_CONCAT(gSfallMemoryArea, __LINE__)(address, (void**)&(variable))
+
+#define SFALL_MEMORY_ACCESSOR(address, get, set) \
+    static SfallMemoryArea SFALL_MEMORY_CONCAT(gSfallMemoryArea, __LINE__)(address, get, set)
+
+// (A lambda, as often as not: what follows the address.)
+#define SFALL_MEMORY_CALL(address, ...) \
+    static SfallMemoryCall SFALL_MEMORY_CONCAT(gSfallMemoryCall, __LINE__)(address, __VA_ARGS__)
+
+// Whether a script has changed the original's code kept in `bytes` to `patch`.
+bool sfallMemoryIs(const unsigned char* bytes, std::initializer_list<unsigned char> patch);
+// The little-endian int at `bytes` (an instruction's operand).
+int sfallMemoryInt(const unsigned char* bytes);
+
+// What the scripts' opcodes do: false where nothing is registered.
+bool sfallMemoryRead(unsigned int address, int size, ProgramValue* valuePtr);
+bool sfallMemoryReadString(unsigned int address, std::string* string);
+bool sfallMemoryWrite(unsigned int address, int size, const ProgramValue& value);
+bool sfallMemoryWriteString(unsigned int address, const char* string);
+bool sfallMemoryCall(unsigned int address, const ProgramValue* args, int argCount, ProgramValue* resultPtr);
+
+// What call_offset_* passes: a number, or an object.
+int sfallMemoryArgInt(const ProgramValue& value);
+void* sfallMemoryArgPointer(const ProgramValue& value);
+
+} // namespace fallout
+
+#endif /* FALLOUT_SFALL_MEMORY_H_ */
