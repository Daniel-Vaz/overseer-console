+// SFALL: whether `object` is one of the map's (or off it), for scripts that
+// kept it and ask after it in the original's memory (see sfall_memory.cc).
+bool objectIsLive(Object* object)
+{
+    if (object == nullptr) {
+        return false;
+    }
+
+    for (ObjectListNode* node = gObjectListHead; node != nullptr; node = node->next) {
+        if (node->obj == object) {
+            return true;
+        }
+    }
+
+#if defined(__EMSCRIPTEN__)
+    // Where it was, if it still is an object: its tile's list. (Memory the
+    // engine has can be read, an object gone or not; a number a script made
+    // up may lie beyond it.)
+    if (reinterpret_cast<uintptr_t>(object) + sizeof(Object) <= emscripten_get_heap_size()) {
+        int lastTile = object->tile;
+        if (hexGridTileIsValid(lastTile)) {
+            for (ObjectListNode* node = gObjectListHeadByTile[lastTile]; node != nullptr; node = node->next) {
+                if (node->obj == object) {
+                    return true;
+                }
+            }
+        }
+    }
+#endif
+
+    for (int tile = 0; tile < HEX_GRID_SIZE; tile++) {
+        for (ObjectListNode* node = gObjectListHeadByTile[tile]; node != nullptr; node = node->next) {
+            if (node->obj == object) {
+                return true;
+            }
+        }
+    }
+
+    return false;
+}
