@@ -1177,6 +1178,18 @@ mixed   ret0 - Overrides the target object, or pass -1 to prevent the player fro
 Returns the object to target, or null for none. What a script said on hovering
 holds for the click that follows, as in sfall.
 */
+// sfall's ComputeExplosionOnExtrasHook_Script: what is found on a tile in the
+// radius may be replaced, or left out with 0.
+Object* scriptHooks_OnExplosion(bool isCheck, Object* attacker, int explosionTile, int checkedTile, Object* object, Object* target, bool isThrowing)
+{
+    ScriptHookCall hook(HOOK_ONEXPLOSION, 1, { isCheck ? 1 : 0, attacker, explosionTile, checkedTile, object, target, isThrowing ? 1 : 0 });
+    hook.call();
+    if (hook.numReturnValues() > 0) {
+        return hook.getReturnValueAt(0).asObject();
+    }
+    return object;
+}
