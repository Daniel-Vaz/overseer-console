+// sfall 5 (Olympus 2207 is made for it): array_key_exists.
+static void op_array_key_exists(Program* program)
+{
+    ProgramValue key = programStackPopValue(program);
+    ArrayId arrayId = programStackPopInteger(program);
+    programStackPushInteger(program, ArrayKeyExists(arrayId, key, program) ? 1 : 0);
+}
+
+// sfall 5: get_config_setting, a setting of sfall's own (ddraw.ini), of
+// the type of the default given; -1 for a section or key that is not a string.
+static void op_get_config_setting(Program* program)
+{
+    ProgramValue defaultValue = programStackPopValue(program);
+    ProgramValue keyValue = programStackPopValue(program);
+    ProgramValue sectionValue = programStackPopValue(program);
+    if (!sectionValue.isString() || !keyValue.isString()) {
+        programStackPushInteger(program, -1);
+        return;
+    }
+
+    char* value;
+    bool found = configGetString(&gSfallConfig, sectionValue.asString(program), keyValue.asString(program), &value);
+    if (defaultValue.isString()) {
+        programStackPushString(program, found ? value : defaultValue.asString(program));
+    } else {
+        programStackPushInteger(program, found ? static_cast<int>(strtol(value, nullptr, 0)) : defaultValue.asInt());
+    }
+}
+
+// sfall 5: set_config_setting, for the time the game runs.
+static void op_set_config_setting(Program* program)
+{
+    ProgramValue value = programStackPopValue(program);
+    ProgramValue keyValue = programStackPopValue(program);
+    ProgramValue sectionValue = programStackPopValue(program);
+    if (!sectionValue.isString() || !keyValue.isString()) {
+        programStackPushInteger(program, -1);
+        return;
+    }
+
+    char number[16];
+    const char* text = value.isString() ? value.asString(program) : number;
+    if (!value.isString()) {
+        snprintf(number, sizeof(number), "%d", value.asInt());
+    }
+    configSetString(&gSfallConfig, sectionValue.asString(program), keyValue.asString(program), text);
+    programStackPushInteger(program, 0);
+}
+
+// sfall 5: set_shader_type. The engine has no shaders.
+static void op_set_shader_type(Program* program)
+{
+    programStackPopInteger(program);
+    programStackPopInteger(program);
+}
+
+// sfall 5: get_perk_freq, the levels between perks.
+static void op_get_perk_freq(Program* program)
+{
+    programStackPushInteger(program, characterEditorGetPerkFrequency());
+}
+
