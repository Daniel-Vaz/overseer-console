+/*
+sfall 5: Runs after an item is added to the inventory of an object, moved there from another or not.
+
+Object  arg0 - The object the item is added to
+Item    arg1 - The item added
+int     arg2 - The number of items added
+*/
+void scriptHooks_AddInventoryObject(Object* owner, Object* item, int quantity)
+{
+    ScriptHookCall(HOOK_ADDINVENOBJ, 0, { owner, item, quantity }).call();
+}
+
+/*
+sfall 5: Runs when the least and most damage of an attack are worked out to be shown (the inventory's figures).
+
+Critter arg0 - The critter whose damage it is (usually dude_obj)
+Item    arg1 - The weapon, or 0 for an unarmed attack
+int     arg2 - The attack type (ATKTYPE_*)
+int     arg3 - The least damage
+int     arg4 - The most damage
+
+int     ret0 - The new least damage
+int     ret1 - The new most damage
+*/
+void scriptHooks_DisplayDamage(Object* critter, Object* weapon, HitMode hitMode, int* minDamagePtr, int* maxDamagePtr)
+{
+    ScriptHookCall hook(HOOK_DISPLAYDAMAGE, 2, { critter, weapon, hitMode, *minDamagePtr, *maxDamagePtr });
+    hook.call();
+
+    if (hook.numReturnValues() > 0) {
+        *minDamagePtr = hook.getReturnValueAt(0).asInt();
+        if (hook.numReturnValues() > 1) {
+            *maxDamagePtr = hook.getReturnValueAt(1).asInt();
+        }
+    }
+}
+
+/*
+sfall 5: Runs at the start of every attack, and at its end (after all its actions and animations). Its values can
+be changed only at the start.
+
+int     arg0 - Event type: 0 - the start of the attack, 1 - its end
+Critter arg1 - The attacker
+Object  arg2 - The target (a critter or an object)
+Item    arg3 - The attacker's weapon
+int     arg4 - The body part aimed at (BODY_HIT_*), always 8 (BODY_UNCALLED) for a target that is not a critter
+int     arg5 - The attack type (ATKTYPE_*)
+
+int     ret0 - Overrides the body part aimed at, or -1 to leave it
+int     ret1 - Overrides the attack type
+*/
+void scriptHooks_CombatAttack(int type, Object* attacker, Object* target, Object* weapon, HitLocation* hitLocationPtr, HitMode* hitModePtr)
+{
+    ScriptHookCall hook(HOOK_COMBATATTACK, type == 0 ? 2 : 0, { type, attacker, target, weapon, *hitLocationPtr, *hitModePtr });
+    hook.call();
+
+    if (type == 0 && hook.numReturnValues() > 0) {
+        int hitLocation = hook.getReturnValueAt(0).asInt();
+        if (hitLocation >= 0 && hitLocation < HIT_LOCATION_COUNT) {
+            *hitLocationPtr = static_cast<HitLocation>(hitLocation);
+        }
+        if (hook.numReturnValues() > 1) {
+            int hitMode = hook.getReturnValueAt(1).asInt();
+            if (hitMode >= 0 && hitMode < HIT_MODE_COUNT) {
+                *hitModePtr = static_cast<HitMode>(hitMode);
+            }
+        }
+    }
+}
+
+/*
+sfall 5: Runs when the result of an attack worked out in HOOK_AFTERHITROLL is checked.
+
+Critter arg0 - The attacker
+Critter arg1 - The target
+Item    arg2 - The weapon used in the attack
+int     arg3 - The result of the attack (ROLL_*)
+int     arg4 - The perk that made the result a critical success or failure (PERK_slayer, PERK_silent_death,
+               PERK_jinxed / TRAIT_jinxed), -1 for an unarmed attack's critical success
+int     arg5 - The attack type (ATKTYPE_*)
+int     arg6 - The body part aimed at (BODY_HIT_*)
+
+int     ret0 - Overrides the result of the attack
+*/
+int scriptHooks_AttackHitRoll(Object* attacker, Object* target, Object* weapon, int roll, int perk, HitMode hitMode, HitLocation hitLocation)
+{
+    ScriptHookCall hook(HOOK_ATTACKHITROLL, 1, { attacker, target, weapon, roll, perk, hitMode, hitLocation });
+    hook.call();
+
+    if (hook.numReturnValues() > 0) {
+        roll = hook.getReturnValueAt(0).asInt();
+    }
+
+    return roll;
+}
+
+/*
+sfall 5: Runs when the effects of a drug are applied: its first, immediate, effect, and its second and third,
+delayed. Some of what they do can be changed.
+
+Critter arg0 - The critter the drug is taken by
+int     arg1 - The drug's PID
+int     arg2 - The delay in ticks before the effect (Chem Resistant counted; 600 is a minute of the game), 0 for the
+               immediate effect, -1 when the drug does nothing any more (its effects will not be applied)
+int     arg3 - stat0 of the effect (-1 for none)
+int     arg4 - amount0
+int     arg5 - stat1
+int     arg6 - amount1
+int     arg7 - stat2
+int     arg8 - amount2
+int     arg9 - The addiction perk (first effect only, else -1)
+int     arg10 - The chance of addiction in percent (without Chem Reliant, Chem Resistant, Flower Child)
+int     arg11 - The delay in minutes before the addiction takes effect (first effect only, else -1)
+
+int     ret0 - The new delay; for the immediate effect, of the addiction (-1 to leave it)
+int     ret1 - The new chance of addiction, -1 to leave it (first effect only)
+int     ret2 - The new stat0
+int     ret3 - The new amount0
+int     ret4 - The new stat1
+int     ret5 - The new amount1
+int     ret6 - The new stat2
+int     ret7 - The new amount2
+*/
+void scriptHooks_DrugsEffect(Object* critter, int drugPid, int* delayPtr, Stat* stats, int* amounts, int addictionPerk, int* addictionChancePtr, int* addictionDelayPtr)
+{
+    bool first = addictionChancePtr != nullptr;
+    ScriptHookCall hook(HOOK_DRUGSEFFECT, 8, {
+                                                 critter,
+                                                 drugPid,
+                                                 *delayPtr,
+                                                 stats[0],
+                                                 amounts[0],
+                                                 stats[1],
+                                                 amounts[1],
+                                                 stats[2],
+                                                 amounts[2],
+                                                 first ? addictionPerk : -1,
+                                                 first ? *addictionChancePtr : -1,
+                                                 first && addictionDelayPtr != nullptr ? *addictionDelayPtr : -1,
+                                             });
+    hook.call();
+
+    int count = hook.numReturnValues();
+    if (count > 0 && hook.getReturnValueAt(0).asInt() != -1) {
+        if (*delayPtr == 0 && addictionDelayPtr != nullptr) {
+            *addictionDelayPtr = hook.getReturnValueAt(0).asInt();
+        } else if (*delayPtr > 0) {
+            *delayPtr = hook.getReturnValueAt(0).asInt();
+        }
+    }
+    if (count > 1 && first && hook.getReturnValueAt(1).asInt() != -1) {
+        *addictionChancePtr = hook.getReturnValueAt(1).asInt();
+    }
+    for (int index = 0; index < 3; index++) {
+        if (count > 2 + index * 2) {
+            stats[index] = static_cast<Stat>(hook.getReturnValueAt(2 + index * 2).asInt());
+        }
+        if (count > 3 + index * 2) {
+            amounts[index] = hook.getReturnValueAt(3 + index * 2).asInt();
+        }
+    }
+}
