     // 0x827e - void reg_anim_callback(procedure proc)
     interpreterRegisterOpcode(0x827e, op_reg_anim_callback);
+
+    // sfall 5 (Olympus 2207 is made for it).
+    // 0x8282 - any  get_config_setting(string section, string key, any default)
