+static FrmId gameMouseActionMenuItemFrmId(int menuItem, int frame)
+{
+    static int orderArtFound = -1;
+    if (menuItem == GAME_MOUSE_ACTION_MENU_ITEM_ORDER_ATTACK && frame == GAME_MOUSE_ACTION_MENU_ITEM_FRAME_HIGHLIGHTED) {
+        if (orderArtFound == -1) {
+            CacheEntry* handle;
+            Art* art = artLock(kGameMouseActionMenuItemFrmIds[menuItem][frame], &handle);
+            orderArtFound = art != nullptr ? 1 : 0;
+            if (art != nullptr) {
+                artUnlock(handle);
+            }
+        }
+        if (orderArtFound == 0) {
+            return kGameMouseActionMenuItemFrmIds[GAME_MOUSE_ACTION_MENU_ITEM_TALK][frame];
+        }
+    }
+    return kGameMouseActionMenuItemFrmIds[menuItem][frame];
+}
