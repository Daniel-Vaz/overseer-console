+void partyOrderAttackEnable()
+{
+    gPartyOrderAttack = true;
+}
+
+void partyOrderAttackReset()
+{
+    gPartyOrderTargets.clear();
+}
+
+// Before a party member's turn picks whom to fight: the one it was told to.
+void partyOrderAttackApply(Object* attacker)
+{
+    if (attacker->data.critter.combat.team != 0 || gPartyOrderTargets.empty()) {
+        return;
+    }
+
+    for (auto& order : gPartyOrderTargets) {
+        if (order.memberId == attacker->id) {
+            if (order.target != nullptr && (!objectIsLive(order.target) || critterIsDead(order.target))) {
+                order.target = nullptr;
+            }
+            if (order.target != nullptr) {
+                attacker->data.critter.combat.whoHitMe = order.target;
+            }
+            return;
+        }
+    }
+}
+
+static void partyOrderRefresh(Object* object)
+{
+    Rect rect;
+    objectGetRect(object, &rect);
+    rect.left -= 1;
+    rect.top -= 1;
+    rect.right += 1;
+    rect.bottom += 1;
+    tileWindowRefreshRect(&rect, gElevation);
+}
+
+// sfall's action_attack_to: the pointer picks a foe of the party member's,
+// lit red where it can see it and get to it, grey where not; a left click on
+// one lit red tells it to attack, a right click or ESC takes it all back.
+static void partyOrderPickTarget(Object* member)
+{
+    gameMouseSetCursor(MOUSE_CURSOR_CROSSHAIR);
+    gameMouseSetMode(GAME_MOUSE_MODE_CROSSHAIR);
+
+    Object* hovered = nullptr;
+    OutlineType hoveredOutline = OUTLINE_TYPE_NONE;
+    Object* valid = nullptr;
+    bool chosen = false;
+
+    while (_game_user_wants_to_quit == GAME_QUIT_REQUEST_NONE) {
+        sharedFpsLimiter.mark();
+
+        int keyCode = inputGetInput();
+        int mouseEvent = mouseGetEvent();
+
+        Object* under = gameMouseGetObjectUnderCursor(OBJ_TYPE_CRITTER, false, gElevation);
+        if (hovered != nullptr && hovered != under) {
+            hovered->outline = hoveredOutline;
+            partyOrderRefresh(hovered);
+            hovered = nullptr;
+            valid = nullptr;
+        }
+
+        if (under != nullptr && under != hovered && under != member
+            && under->data.critter.combat.team != member->data.critter.combat.team && !critterIsDead(under)) {
+            hoveredOutline = under->outline;
+            bool reachable = (_combatNumTurns != 0 || under->data.critter.combat.maneuver != CRITTER_MANEUVER_NONE)
+                && isWithinPerception(member, under)
+                && pathfinderFindPath(member, member->tile, under->tile, nullptr, 0, _obj_blocking_at) > 0;
+            under->outline = reachable ? OUTLINE_TYPE_HOSTILE : OUTLINE_TYPE_BODY;
+            valid = reachable ? under : nullptr;
+            hovered = under;
+            partyOrderRefresh(under);
+        }
+
+        if (valid != nullptr && (mouseEvent & MOUSE_EVENT_LEFT_BUTTON_DOWN) != 0) {
+            chosen = true;
+            break;
+        }
+
+        if ((mouseEvent & MOUSE_EVENT_RIGHT_BUTTON_DOWN) != 0 || keyCode == KEY_ESCAPE) {
+            break;
+        }
+
+        renderPresent();
+        sharedFpsLimiter.throttle();
+    }
+
+    if (hovered != nullptr) {
+        hovered->outline = hoveredOutline;
+        partyOrderRefresh(hovered);
+    }
+
+    if (chosen) {
+        bool known = false;
+        for (auto& order : gPartyOrderTargets) {
+            if (order.memberId == member->id) {
+                order.target = valid;
+                known = true;
+            }
+        }
+        if (!known) {
+            gPartyOrderTargets.push_back({ member->id, valid });
+        }
+
+        AiPacket* ai = aiGetPacket(member);
+        if (ai->disposition == DISPOSITION_CUSTOM) {
+            ai->attack_who = ATTACK_WHO_WHOMEVER;
+        }
+
+        // sfall's words for it.
+        static const char* kHuman[] = { "I'll take care of it.", "Okay, I got it." };
+        char message[64];
+        switch (critterGetBodyType(member)) {
+        case BODY_TYPE_QUADRUPED:
+            snprintf(message, sizeof(message), "%s", "::Growl::");
+            break;
+        case BODY_TYPE_ROBOTIC:
+            snprintf(message, sizeof(message), "%s", "::Beep::");
+            break;
+        default:
+            snprintf(message, sizeof(message), "%s", kHuman[randomBetween(0, 1)]);
+            break;
+        }
+
+        Rect rect;
+        if (textObjectAdd(member, message, ai->font, ai->color, ai->outline_color, &rect) == 0) {
+            tileWindowRefreshRect(&rect, member->elevation);
+        }
+    }
+
+    gameMouseSetCursor(MOUSE_CURSOR_NONE);
+    gameMouseSetMode(GAME_MOUSE_MODE_ARROW);
+}
+
 } // namespace fallout
