+// A hook script (hs_*.int) runs as a global script does, and also for its hook.
+static Program* sfall_gl_scr_load_hook_script(const char* path)
+{
+    Program* program = programCreateByPath(path);
+    if (program != nullptr) {
+        scriptDetachedContextRegister(program, DetachedScriptOwnerKind::GlobalScript);
+
+        GlobalScript scr;
+        scr.program = program;
+
+        for (ScriptProc action = SCRIPT_PROC_FIRST; action < SCRIPT_PROC_COUNT; action++) {
+            scr.procs[action] = programFindProcedure(program, gScriptProcNames[action]);
+        }
+
+        state->globalScripts.push_back(std::move(scr));
+    }
+    return program;
+}
+
 void sfall_gl_scr_exec_start_proc()
 {
+    // As in sfall: hook scripts are loaded and started before global scripts.
+    size_t firstHookScript = state->globalScripts.size();
+    scriptHooksLoadHookScripts(sfall_gl_scr_load_hook_script);
+    for (size_t index = firstHookScript; index < state->globalScripts.size(); index++) {
+        programInterpret(state->globalScripts[index].program, -1);
+    }
+
     for (auto& path : state->paths) {
         Program* program = programCreateByPath(path.c_str());
