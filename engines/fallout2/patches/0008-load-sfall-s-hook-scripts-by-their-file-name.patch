+void scriptHooksLoadHookScripts(Program* (*load)(const char* path))
+{
+    Program* loaded[HOOK_COUNT] = { nullptr };
+    for (size_t index = 0; index < sizeof(kHookScripts) / sizeof(kHookScripts[0]); index++) {
+        const HookType hookType = kHookScripts[index].hookType;
+
+        char path[COMPAT_MAX_PATH];
+        snprintf(path, sizeof(path), "scripts\\%s.int", kHookScripts[index].name);
+
+        // The program of a script that serves an earlier hook too.
+        Program* program = nullptr;
+        for (size_t earlier = 0; earlier < index; earlier++) {
+            if (strcmp(kHookScripts[earlier].name, kHookScripts[index].name) == 0) {
+                program = loaded[kHookScripts[earlier].hookType];
+                break;
+            }
+        }
+
+        int size;
+        if (program == nullptr && dbGetFileSize(path, &size) == 0) {
+            program = load(path);
+        }
+
+        if (program == nullptr) {
+            continue;
+        }
+
+        int start = programFindProcedure(program, "start");
+        if (start == -1) {
+            continue;
+        }
+
+        loaded[hookType] = program;
+        scriptHooks[hookType].emplace(scriptHooks[hookType].begin(), ScriptHook { program, start });
+        hasHookScript[hookType] = true;
+        debugPrint("Loaded hook script %s\n", path);
+    }
+}
