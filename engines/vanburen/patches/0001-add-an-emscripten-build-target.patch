Add an Emscripten build target

Builds the game alone for the browser: SDL2 and FreeType from the Emscripten
ports, OpenGL ES 3 (WebGL 2) for OpenGL 3.3, Emscripten's OpenAL over Web
Audio, Asyncify for the main loop.

platform/emscripten/GL/glew.h stands in for GLEW and answers for what ES
lacks: wireframe stays filled, and the two textures with a black border colour
(the fog of war's masks) clamp to their edge while the fog shader reads black
outside them itself. The shader helper compiles the shaders as GLSL ES 3.00
and sets the uniforms they declare with a value once they are linked, as
desktop GL does; ES does not allow the declaration. The menu buttons' picture
goes in as a C array, since WebAssembly's assembler has no .incbin.
---
diff --git a/CMakeLists.txt b/CMakeLists.txt
index e7d3a45..d37f2a7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -36,6 +36,43 @@ add_library(vb_game_core src/game/world.cpp)
 target_link_libraries(vb_game_core PUBLIC vb_assets)
 target_include_directories(vb_game_core PUBLIC src)
 
+# ---------------------------------------------------------------------------
+# Browser (WebAssembly) build: the game alone, for a page that boots it.
+# SDL2 and FreeType come from the Emscripten ports, OpenGL ES 3 is WebGL 2
+# (platform/emscripten/GL/glew.h stands in for GLEW), OpenAL is Emscripten's
+# own over Web Audio. Asyncify lets the main loop give the browser its turn.
+# ---------------------------------------------------------------------------
+if(EMSCRIPTEN)
+  # WebAssembly's assembler has no .incbin: the port's own picture goes in as a C array.
+  file(READ "${CMAKE_SOURCE_DIR}/data/menu_buttons.tga" vb_menu_hex HEX)
+  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," vb_menu_hex "${vb_menu_hex}")
+  file(WRITE "${CMAKE_BINARY_DIR}/generated/menu_buttons.inc" "${vb_menu_hex}\n")
+  add_executable(vanburen tools/vanburen/main.cpp tools/vanburen/embedded.cpp)
+  target_compile_definitions(vanburen PRIVATE VB_EMBED_INC="${CMAKE_BINARY_DIR}/generated/menu_buttons.inc")
+  target_include_directories(vanburen PRIVATE tools platform/emscripten)
+  target_compile_options(vanburen PRIVATE "-sUSE_SDL=2" "-sUSE_FREETYPE=1")
+  target_compile_options(vb_assets PRIVATE "-sUSE_SDL=2")
+  target_link_libraries(vanburen vb_game_core vb_assets)
+  target_link_options(vanburen PRIVATE
+    "-sUSE_SDL=2"
+    "-sUSE_FREETYPE=1"
+    "-lopenal"
+    "-sMIN_WEBGL_VERSION=2"
+    "-sMAX_WEBGL_VERSION=2"
+    "-sASYNCIFY"
+    "-sENVIRONMENT=web"
+    "-sALLOW_MEMORY_GROWTH"
+    "-sINITIAL_MEMORY=256MB"
+    "-sMAXIMUM_MEMORY=4GB"
+    "-sSTACK_SIZE=4MB"
+    "-sCASE_INSENSITIVE_FS"
+    "-sMODULARIZE"
+    "-sEXPORT_NAME=vanburen"
+    "-sEXIT_RUNTIME"
+  )
+  return()
+endif()
+
 # graphics deps
 find_package(SDL2 REQUIRED)
 find_package(GLEW REQUIRED)
diff --git a/platform/emscripten/GL/glew.h b/platform/emscripten/GL/glew.h
new file mode 100644
index 0000000..d72989c
--- /dev/null
+++ b/platform/emscripten/GL/glew.h
@@ -0,0 +1,19 @@
+#pragma once
+// The browser build: OpenGL ES 3.0 (WebGL 2) instead of desktop OpenGL 3.3 through GLEW.
+// What the engine uses of desktop GL that ES lacks is answered here, the same way each time.
+#include <GLES3/gl3.h>
+
+#define glewExperimental vb_glewExperimental
+static unsigned char vb_glewExperimental = 0;
+static inline unsigned glewInit() { return 0; }
+
+// Wireframe (a debug view) does not exist in ES: the polygons stay filled.
+#define GL_LINE 0x1B01
+#define GL_FILL 0x1B02
+#define glPolygonMode(face, mode) ((void)0)
+
+// ES 3.0 has no border colour. Both textures that ask for one (the fog of war's
+// masks) want black outside; the fog shader reads 0 there itself (see gmodel.h).
+#define GL_CLAMP_TO_BORDER GL_CLAMP_TO_EDGE
+#define GL_TEXTURE_BORDER_COLOR 0x1004
+#define glTexParameterfv(target, pname, params) ((pname) == GL_TEXTURE_BORDER_COLOR ? (void)0 : glTexParameterfv(target, pname, params))
