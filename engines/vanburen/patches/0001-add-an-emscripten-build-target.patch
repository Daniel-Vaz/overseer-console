diff --git a/tools/common/ui.h b/tools/common/ui.h
index ce7b3d9..35c8ced 100644
--- a/tools/common/ui.h
+++ b/tools/common/ui.h
@@ -7,17 +7,53 @@
 #include <string>
 #include <vector>
 
+#ifdef __EMSCRIPTEN__
+// The browser build compiles the shaders as GLSL ES 3.00 (WebGL 2): its own version line and default precisions. ES does
+// not allow a uniform to be declared with an initial value; those are taken out and set once the program is linked,
+// which is when desktop GL sets them.
+struct EsUniformInit { std::string name; int size = 1; float v[4] = {0, 0, 0, 0}; };
+static std::vector<EsUniformInit>& esUniformInits() { static std::vector<EsUniformInit> v; return v; }
+static std::string toGlslEs(const char* src) {
+    std::string s(src); const std::string desktop = "#version 330 core";
+    if (s.compare(0, desktop.size(), desktop) == 0) s = "#version 300 es\nprecision highp float;\nprecision highp int;" + s.substr(desktop.size());
+    for (size_t at = s.find("uniform "); at != std::string::npos; at = s.find("uniform ", at + 1)) {
+        size_t semi = s.find(';', at), eq = s.find('=', at); if (semi == std::string::npos || eq == std::string::npos || eq > semi) continue;
+        std::string decl = s.substr(at + 8, eq - at - 8), type, name; size_t sp = decl.find(' ');
+        if (sp == std::string::npos) continue; type = decl.substr(0, sp); name = decl.substr(sp + 1); while (!name.empty() && name.back() == ' ') name.pop_back();
+        EsUniformInit u; u.name = name; u.size = type == "float" ? 1 : type.size() == 4 && type.compare(0, 3, "vec") == 0 ? type[3] - '0' : 0;
+        if (u.size < 1 || u.size > 4) continue;
+        std::string val = s.substr(eq + 1, semi - eq - 1); size_t open = val.find('('); const char* p = val.c_str() + (open == std::string::npos ? 0 : open + 1);
+        int n = 0; for (char* end; n < u.size; n++) { u.v[n] = std::strtof(p, &end); if (end == p) break; p = end; while (*p == ' ' || *p == ',') p++; }
+        for (int i = n == 1 ? 1 : u.size; i < u.size; i++) u.v[i] = u.v[0];          // vec4(0.0): one value for every component
+        esUniformInits().push_back(u);
+        s.erase(eq, semi - eq); while (eq > 0 && s[eq - 1] == ' ') s.erase(--eq, 1);
+    }
+    return s;
+}
+#endif
 static GLuint compile(GLenum type, const char* src) {
     GLuint s = glCreateShader(type);
+#ifdef __EMSCRIPTEN__
+    std::string es = toGlslEs(src); src = es.c_str();
+#endif
     glShaderSource(s, 1, &src, nullptr); glCompileShader(s);
     GLint ok; glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
-    if (!ok) { char b[1024]; glGetShaderInfoLog(s, 1024, nullptr, b); std::fprintf(stderr, "shader error: %s\n", b); std::exit(1); }
+    if (!ok) { char b[1024]; glGetShaderInfoLog(s, 1024, nullptr, b); std::fprintf(stderr, "shader error: %s\n%s\n", b, src); std::exit(1); }
     return s;
 }
 static GLuint program(const char* vs, const char* fs) {
     GLuint p = glCreateProgram();
     glAttachShader(p, compile(GL_VERTEX_SHADER, vs)); glAttachShader(p, compile(GL_FRAGMENT_SHADER, fs));
-    glLinkProgram(p); return p;
+    glLinkProgram(p);
+#ifdef __EMSCRIPTEN__
+    GLint was = 0; glGetIntegerv(GL_CURRENT_PROGRAM, &was); glUseProgram(p);
+    for (const EsUniformInit& u : esUniformInits()) {
+        GLint at = glGetUniformLocation(p, u.name.c_str()); if (at < 0) continue;
+        if (u.size == 1) glUniform1fv(at, 1, u.v); else if (u.size == 2) glUniform2fv(at, 1, u.v); else if (u.size == 3) glUniform3fv(at, 1, u.v); else glUniform4fv(at, 1, u.v);
+    }
+    esUniformInits().clear(); glUseProgram((GLuint)was);
+#endif
+    return p;
 }
 
